:host { display: block; min-width: 0; }

.td-dial { position: relative; width: 100%; height: 0; padding-bottom: 100%; color: #102e46; }
.td-ring { position: absolute; top: 0; right: 0; bottom: 0; left: 0; box-sizing: border-box; border: 3rpx solid #c8a5ea; border-radius: 50%; background-color: #f3e8f2; background-image: radial-gradient(rgba(170, 124, 200, .14) .7px, transparent 1px), linear-gradient(135deg, rgba(255, 253, 245, .75), rgba(220, 193, 240, .16) 57%, rgba(254, 238, 212, .7)); background-size: 6rpx 6rpx, 100% 100%; box-shadow: 0 12rpx 21rpx rgba(115, 79, 63, .14), 0 3rpx 6rpx rgba(139, 85, 182, .11), inset 0 0 0 5rpx rgba(255, 253, 246, .65); }
.td-face { position: absolute; top: 28rpx; right: 28rpx; bottom: 28rpx; left: 28rpx; border: 2rpx solid #e7dbc4; border-radius: 50%; background-color: #fffaf0; background-image: radial-gradient(rgba(143, 110, 66, .04) .6px, transparent 1px), linear-gradient(130deg, rgba(255, 255, 255, .48), rgba(247, 234, 207, .25)); background-size: 7rpx 7rpx, 100% 100%; box-shadow: inset 0 0 0 6rpx rgba(243, 234, 210, .6), inset 0 6rpx 12rpx rgba(146, 114, 61, .06); }

.td-ticks { position: absolute; top: 0; right: 0; bottom: 0; left: 0; pointer-events: none; }
.td-tick-arm { position: absolute; top: 0; bottom: 0; left: 50%; width: 0; transform-origin: 50% 50%; }
.td-tick { position: absolute; top: 16rpx; left: -2rpx; width: 4rpx; height: 12rpx; border-radius: 4rpx; background: #9473b2; }
.td-tick--major { top: 14rpx; left: -3rpx; width: 6rpx; height: 17rpx; }
.td-crown { position: absolute; z-index: 2; top: 2rpx; left: 50%; box-sizing: border-box; width: 27rpx; height: 27rpx; border: 4rpx solid #fff9e9; border-radius: 50%; background: #c39a40; box-shadow: 0 0 0 2rpx #d5b768, 0 3rpx 5rpx rgba(143, 105, 29, .14); transform: translate(-50%, -15%); }

.td-reading { position: absolute; z-index: 3; top: 29%; right: 9%; left: 9%; text-align: center; }
.td-label { display: block; color: #3e4b4c; font-family: "Kaiti SC", "STKaiti", "KaiTi", "Songti SC", serif; font-size: 28rpx; font-weight: 600; line-height: 1.5; }
.td-time { display: block; max-width: 100%; margin-top: 14rpx; color: #102e46; font-family: Georgia, "Times New Roman", serif; font-size: 124rpx; font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1.13; letter-spacing: -4rpx; white-space: nowrap; }
.td-time--compact { font-size: 94rpx; letter-spacing: -2rpx; }
.td-time--small { font-size: 69rpx; letter-spacing: -1rpx; }
.td-status { display: inline-flex; box-sizing: border-box; justify-content: center; align-items: center; max-width: 100%; min-width: 310rpx; min-height: 50rpx; margin-top: 18rpx; padding: 7rpx 20rpx; border: 2rpx solid #e9d8ef; border-radius: 50rpx 48rpx 46rpx 44rpx; background: #fbf3f5; box-shadow: 0 3rpx 7rpx rgba(119, 82, 127, .06); }
.td-status-text { color: #455052; font-family: "Kaiti SC", "STKaiti", "KaiTi", "Songti SC", serif; font-size: 24rpx; line-height: 1.5; word-break: break-all; }

.td-cat { position: absolute; z-index: 5; top: -49rpx; right: -25rpx; display: block; width: 203rpx; height: 203rpx; pointer-events: none; }
.td-ink { position: absolute; z-index: 1; width: 10rpx; height: 35rpx; border-radius: 8rpx; background: #bc8be7; opacity: .76; pointer-events: none; }
.td-ink::after { position: absolute; top: 17rpx; left: -30rpx; width: 10rpx; height: 42rpx; border-radius: 8rpx; background: #bc8be7; transform: rotate(-30deg); content: ""; }
.td-ink--left { top: -6rpx; left: 63rpx; transform: rotate(-16deg); }
.td-ink--right { top: 7rpx; right: -14rpx; width: 8rpx; height: 26rpx; transform: rotate(38deg); }
.td-ink--right::after { top: 15rpx; left: 18rpx; width: 8rpx; height: 26rpx; transform: rotate(24deg); }
.td-spark { position: absolute; width: 10rpx; height: 37rpx; border-radius: 60%; background: currentColor; pointer-events: none; }
.td-spark::after { position: absolute; top: 14rpx; left: -12rpx; width: 34rpx; height: 9rpx; border-radius: 60%; background: currentColor; content: ""; }
.td-spark--gold { top: 61%; left: -32rpx; color: #ecc363; transform: rotate(-8deg); }
.td-spark--violet { right: -30rpx; bottom: 16%; color: #be98df; transform: scale(.8); }
