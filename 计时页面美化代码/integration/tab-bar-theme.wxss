/* 可选：将本文件内容追加到此前 custom-tab-bar/index.wxss。
 * 同时将旧 WXML 根节点 class 改为：
 * class="tab-bar {{selected === 2 ? 'tab-bar--timer' : ''}}"
 * 这些规则只在计时页生效，不改变底栏高度和导航逻辑。
 */
.tab-bar--timer { background: #fbf8f0; box-shadow: 0 -4rpx 14rpx rgba(131, 108, 77, .035); }
.tab-bar--timer::before { background: #efe5d8; }
.tab-bar--timer .tab-bar__item { position: relative; color: #8b9182; }
.tab-bar--timer .tab-bar__item--active { color: #743dc3; }
.tab-bar--timer .tab-bar__icon-wrap { position: relative; }
.tab-bar--timer .tab-bar__item--active .tab-bar__icon-wrap { background: transparent; }
.tab-bar--timer .tab-bar__item--active .tab-bar__icon-wrap::before { position: absolute; top: -4rpx; right: 5rpx; bottom: -5rpx; left: 5rpx; border: 5rpx solid rgba(211, 177, 239, .5); border-radius: 46% 54% 48% 52%; transform: rotate(-19deg); content: ""; }
.tab-bar--timer .tab-bar__icon { position: relative; z-index: 1; }
.tab-bar--timer .tab-bar__item--active::after { position: absolute; top: auto; right: auto; bottom: 0; left: 50%; width: 8rpx; height: 8rpx; margin: 0; border: 0; border-radius: 50%; background: #aa70ee; transform: translateX(-50%); content: ""; }
