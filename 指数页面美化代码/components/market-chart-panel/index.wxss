:host {
  display: block;
  width: 100%;
}

.market-chart-panel {
  width: 100%;
  max-width: 670rpx;
  box-sizing: border-box;
  color: #818980;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.period-tabs {
  display: flex;
  align-items: stretch;
  width: 100%;
  height: 76rpx;
  margin-bottom: 14rpx;
}

.period-tab,
.zoom-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 0;
  margin: 0;
  padding: 0;
  border: 0;
  outline: none;
  border-radius: 0;
  font-family: inherit;
  text-align: center;
}

.period-tab::after,
.zoom-button::after {
  border: 0;
}

.period-tab,
.period-tab[disabled] {
  position: relative;
  flex: 1;
  width: 25%;
  height: 76rpx;
  padding-bottom: 12rpx;
  overflow: visible;
  background: transparent;
  color: #7d8884;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 44rpx;
  letter-spacing: 1rpx;
}

.period-tab--active,
.period-tab--active[disabled] {
  color: #183d4a;
  font-weight: 600;
}

.period-label {
  position: relative;
  z-index: 1;
}

.period-underline {
  position: absolute;
  bottom: 9rpx;
  left: 50%;
  width: 62rpx;
  height: 5rpx;
  margin-left: -31rpx;
  border-radius: 50% 24% 42% 30%;
  background: #b28adf;
  transform: rotate(-1.5deg);
  pointer-events: none;
}

.period-underline::before {
  position: absolute;
  top: 3rpx;
  right: -3rpx;
  left: 4rpx;
  height: 2rpx;
  border-radius: 50%;
  background: rgba(178, 138, 223, 0.48);
  content: "";
  transform: rotate(1deg);
}

.period-tab--pressed .period-label {
  opacity: 0.72;
}

.chart-frame {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  padding: 14rpx 12rpx;
}

.chart-paper-layer,
.chart-paper-face,
.chart-tape {
  position: absolute;
  box-sizing: border-box;
  pointer-events: none;
}

.chart-paper-layer {
  z-index: 0;
  top: 5rpx;
  right: -2rpx;
  bottom: -4rpx;
  left: 3rpx;
  border: 1rpx solid #ecdfcd;
  border-radius: 9rpx 11rpx 8rpx 12rpx;
  background: #f7f0e5;
  box-shadow: 0 4rpx 10rpx rgba(110, 82, 47, 0.07);
  transform: rotate(0.25deg);
}

.chart-paper-face {
  z-index: 1;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border: 1rpx solid #eee3d2;
  border-radius: 11rpx 9rpx 12rpx 8rpx;
  background-color: #fffbf4;
  background-image: linear-gradient(135deg, rgba(255, 255, 255, 0.8), rgba(245, 233, 215, 0.24));
  box-shadow: 0 2rpx 8rpx rgba(110, 82, 47, 0.06), inset 0 0 0 2rpx rgba(255, 255, 255, 0.62);
}

/* The parent's existing chart owns its rendering, axes and touch handlers. */
.chart-slot {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 430rpx;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid #e6ebe7;
  border-radius: 12rpx;
  background: #fdfefd;
}

/* Keep the tape below the slot's bottom edge, including its rotation. */
.chart-tape {
  z-index: 3;
  right: -5rpx;
  bottom: -11rpx;
  width: 60rpx;
  height: 14rpx;
  border-left: 2rpx dashed rgba(255, 255, 255, 0.48);
  border-right: 2rpx dashed rgba(255, 255, 255, 0.48);
  background-color: rgba(194, 158, 226, 0.61);
  background-image: linear-gradient(45deg, transparent 46%, rgba(255, 255, 255, 0.34) 49%, rgba(255, 255, 255, 0.34) 51%, transparent 54%);
  background-size: 12rpx 12rpx;
  transform: rotate(-14deg);
}

.chart-tools {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  box-sizing: border-box;
  width: 100%;
  margin-top: 22rpx;
  padding: 0 8rpx 0 18rpx;
}

.chart-help {
  min-width: 0;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 32rpx;
}

.chart-legend,
.legend-item {
  display: flex;
  align-items: center;
}

.legend-item + .legend-item {
  margin-left: 16rpx;
}

.legend-swatch {
  width: 14rpx;
  height: 16rpx;
  box-sizing: border-box;
  margin-right: 7rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.32);
  border-radius: 3rpx;
}

.legend-swatch--up {
  background: #ed433e;
}

.legend-swatch--down {
  background: #07945e;
}

.chart-hint {
  margin-top: 3rpx;
}

.zoom-controls {
  display: flex;
  align-items: center;
}

.zoom-button,
.zoom-button[disabled] {
  width: 62rpx;
  height: 62rpx;
  border: 1rpx solid #ecdfcd;
  border-radius: 8rpx;
  background: #fffcf6;
  color: #214750;
  box-shadow: 0 3rpx 8rpx rgba(111, 87, 57, 0.1), inset 0 0 0 2rpx rgba(255, 255, 255, 0.72);
}

.zoom-button + .zoom-button {
  margin-left: 12rpx;
}

.zoom-button--unavailable,
.zoom-button--unavailable[disabled] {
  color: #a4ada5;
}

.zoom-symbol {
  display: block;
  font-size: 46rpx;
  font-weight: 400;
  line-height: 52rpx;
}

.zoom-button--pressed {
  background: #f7efdf;
  box-shadow: 0 1rpx 3rpx rgba(111, 87, 57, 0.08);
}
