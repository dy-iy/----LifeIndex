.ip-page {
  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  overflow: hidden;
  padding: 28rpx 40rpx 156rpx;
  padding-bottom: calc(156rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(156rpx + env(safe-area-inset-bottom));
  color: #183844;
  background-color: #fbf7ee;
  background-image:
    radial-gradient(rgba(149, 119, 73, .055) .6px, transparent 1px),
    linear-gradient(125deg, rgba(255, 255, 255, .42), rgba(250, 239, 218, .12));
  background-size: 7rpx 7rpx, 100% 100%;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.ip-content { position: relative; z-index: 1; }
.ip-chart-section { margin-top: 21rpx; }

/* slot 内的节点属于页面，容器样式保留在页面 WXSS 中。 */
.ip-chart-host { box-sizing: border-box; width: 100%; height: 100%; min-width: 0; }

.ip-corner {
  position: absolute;
  z-index: 0;
  top: -79rpx;
  right: -102rpx;
  width: 299rpx;
  height: 430rpx;
  opacity: .65;
  pointer-events: none;
  transform: rotate(-9deg);
}

.ip-corner-sheet {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 10rpx;
  left: 0;
  border: 2rpx solid rgba(255, 253, 250, .92);
  border-radius: 2rpx 0 0 40rpx;
  background-color: #eee0f1;
  background-image:
    radial-gradient(rgba(167, 127, 186, .10) .8px, transparent 1.2px),
    linear-gradient(125deg, rgba(255, 251, 246, .8), transparent 65%);
  background-size: 8rpx 8rpx, 100% 100%;
  box-shadow: -5rpx 7rpx 12rpx rgba(104, 79, 61, .08);
}

.ip-corner-fold {
  position: absolute;
  right: 6rpx;
  bottom: -4rpx;
  left: 8rpx;
  height: 33rpx;
  border-bottom: 3rpx solid rgba(212, 194, 166, .44);
  border-radius: 0 0 4rpx 70%;
  background: #fff9ef;
  transform: rotate(8deg);
}

.ip-corner-dot { position: absolute; top: 200rpx; left: 38rpx; width: 71rpx; height: 71rpx; border-radius: 50%; background: rgba(236, 192, 98, .45); }
.ip-corner-loop { position: absolute; top: 171rpx; left: 2rpx; width: 216rpx; height: 149rpx; border-top: 3rpx solid rgba(173, 121, 216, .43); border-left: 3rpx solid rgba(173, 121, 216, .35); border-radius: 60% 37% 0 37%; transform: rotate(-34deg); }
.ip-gold-spark { position: absolute; top: 32rpx; right: 242rpx; width: 7rpx; height: 27rpx; border-radius: 60%; background: #e2b459; opacity: .68; pointer-events: none; }
.ip-gold-spark::after { position: absolute; top: 10rpx; left: -8rpx; width: 23rpx; height: 7rpx; border-radius: 60%; background: #e2b459; content: ""; }

.ip-footer-art { position: relative; height: 109rpx; margin-top: 19rpx; pointer-events: none; }
.ip-footer-paper { position: absolute; bottom: -19rpx; left: -65rpx; width: 237rpx; height: 132rpx; border-radius: 5% 44% 0 0; background: rgba(213, 181, 235, .22); transform: rotate(-11deg); }
.ip-footer-curve { position: absolute; top: 36rpx; left: -64rpx; width: 520rpx; height: 84rpx; border-top: 3rpx solid rgba(176, 126, 218, .35); border-radius: 55%; transform: rotate(8deg); }
.ip-footer-dot { position: absolute; top: 51rpx; left: 174rpx; width: 12rpx; height: 12rpx; border-radius: 50%; background: #edc573; }
.ip-sprig { position: absolute; right: 54rpx; bottom: 0; width: 114rpx; height: 108rpx; transform: rotate(9deg); }
.ip-sprig-stem { position: absolute; bottom: 0; left: 36rpx; width: 36rpx; height: 108rpx; border-left: 3rpx solid #ceb7df; border-radius: 60% 0 0 0; transform: rotate(14deg); }
.ip-leaf { position: absolute; width: 36rpx; height: 71rpx; border: 3rpx solid #ceb7df; border-radius: 100% 0 100% 0; }
.ip-leaf--left { top: 7rpx; left: 5rpx; transform: rotate(111deg); }
.ip-leaf--right { top: -1rpx; right: 0; transform: rotate(28deg); }

@media (max-height: 640px) {
  .ip-page { padding-top: 20rpx; }
  .ip-footer-art { height: 75rpx; }
}
