 .nav { position: fixed; bottom: 0; left: 0; right: 0; z-index: 90; background: #f5f1e7; border-top: 1rpx solid #d9ddcc; padding-bottom: env(safe-area-inset-bottom); }.nav-inner { display: flex; align-items: center; height: 112rpx; padding: 0 24rpx; }.nav-item { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; flex: 1; color: #8b9182; font-size: 21rpx; height: 100%; }.nav-icon { width: 40rpx; height: 40rpx; margin-bottom: 8rpx; }.active { color: #234b3b; }.nav-dot { position: absolute; width: 7rpx; height: 7rpx; background: #ca5e40; border-radius: 50%; bottom: 5rpx; }
