:host { display: block; min-width: 0; }
.member-list { margin-top: 34rpx; color: #253d35; }
.member-row {
  position: relative;
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 148rpx;
  padding: 18rpx 24rpx;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, .82);
  border-radius: 999rpx;
  background-color: rgba(255, 255, 255, .38);
  background-image: linear-gradient(125deg, rgba(255, 255, 255, .58), rgba(255, 255, 255, .12) 48%, rgba(228, 241, 234, .3));
  -webkit-backdrop-filter: blur(18rpx) saturate(145%);
  backdrop-filter: blur(18rpx) saturate(145%);
  box-shadow: 0 8rpx 24rpx rgba(66, 82, 70, .065), inset 0 2rpx 2rpx rgba(255, 255, 255, .9), inset 0 -2rpx 3rpx rgba(132, 158, 145, .12);
}
.member-row + .member-row { margin-top: 18rpx; }
.member-row::before { position: absolute; top: 0; right: 0; left: 0; height: 52%; border-radius: inherit; background: linear-gradient(180deg, rgba(255, 255, 255, .38), rgba(255, 255, 255, 0)); content: ""; pointer-events: none; }
.member-row::after { position: absolute; top: 1rpx; right: 1rpx; bottom: 1rpx; left: 1rpx; border: 1rpx solid rgba(255, 255, 255, .26); border-radius: inherit; content: ""; pointer-events: none; }
.member-row > view { position: relative; z-index: 1; }
.member-identity { display: flex; flex: 0 0 92rpx; flex-direction: column; align-items: center; min-width: 0; }
.member-avatar { display: block; box-sizing: border-box; width: 64rpx; height: 64rpx; border: 2rpx solid rgba(255, 255, 255, .88); border-radius: 50%; background: #edeade; box-shadow: 0 2rpx 7rpx rgba(66, 82, 70, .08); }
.member-avatar-fallback { display: flex; align-items: center; justify-content: center; color: #688274; font-size: 29rpx; }
.member-name { display: block; max-width: 100%; margin-top: 9rpx; overflow: hidden; color: #344b42; font-size: 23rpx; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.member-class, .member-timer { display: flex; flex: 0 0 80rpx; align-items: center; justify-content: center; min-width: 0; }
.status-label { display: inline-block; box-sizing: border-box; padding: 6rpx 7rpx; border-radius: 999rpx; color: #8b958e; font-size: 21rpx; line-height: 1.3; white-space: nowrap; }
.class-status--in_class { color: #4487b6; background: rgba(123, 183, 224, .12); }
.class-status--idle { color: #8b958e; }
.timer-status--timing { color: #15945e; background: rgba(80, 176, 131, .1); }
.timer-status--not_timing { color: #969b91; }
.member-course { display: flex; flex: 1; flex-direction: column; min-width: 0; }
.course-name { display: block; overflow: hidden; font-size: 23rpx; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
.course-time { display: block; margin-top: 5rpx; color: #939b92; font-size: 19rpx; line-height: 1.4; font-variant-numeric: tabular-nums; white-space: nowrap; }
.member-index { display: flex; flex: 0 0 164rpx; flex-direction: column; align-items: flex-end; min-width: 0; color: #737b80; }
.member-sparkline, .member-sparkline-empty { display: block; width: 164rpx; height: 44rpx; }
.member-sparkline-empty { color: #b0b6aa; font-size: 23rpx; line-height: 44rpx; text-align: center; }
.member-quote { display: flex; flex-wrap: wrap; justify-content: flex-end; align-items: baseline; column-gap: 7rpx; row-gap: 2rpx; width: 100%; margin-top: 5rpx; font-variant-numeric: tabular-nums; }
.member-price { max-width: 100%; overflow: hidden; font-size: 24rpx; font-weight: 600; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.member-percent { font-size: 18rpx; line-height: 1.35; white-space: nowrap; }
.index--rise { color: #e53935; }
.index--fall { color: #15945e; }
.member-empty { padding: 36rpx 0; color: #939b92; font-size: 24rpx; text-align: center; }
.member-error { display: flex; align-items: center; gap: 14rpx; padding: 18rpx 0; color: #ad5948; font-size: 22rpx; line-height: 1.5; }
.member-error > text { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.member-error button { flex-shrink: 0; width: auto; margin: 0; padding: 6rpx 14rpx; background: transparent; color: #496951; font-size: 22rpx; line-height: 1.5; }
.member-error button::after { border: 0; }
