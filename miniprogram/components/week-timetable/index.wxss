:host { display: block; }
view, text { box-sizing: border-box; }
.week-timetable { color: #234b3b; }
.grid-toolbar { padding: 4rpx 1rpx 19rpx; }
.grid-count { display: flex; align-items: center; gap: 10rpx; font-size: 21rpx; color: #84907d; }
.arrangement-mark { width: 13rpx; height: 13rpx; border: 1rpx solid #9ba78e; border-radius: 3rpx; background: #e8eddd; }
.grid-frame { overflow: hidden; border: 1rpx solid #dce3e6; border-radius: 22rpx; background: #fffdfa; box-shadow: 0 10rpx 28rpx rgba(79, 96, 108, .06); }
.grid-scroll { width: 100%; }
.timetable-sheet { width: 100%; }
.grid-heading { display: flex; height: 112rpx; background: #edf3f7; border-bottom: 1rpx solid #dce3e6; }
.month-heading { display: flex; flex-direction: column; justify-content: center; align-items: center; flex: 0 0 80rpx; width: 80rpx; gap: 1rpx; color: #9c8063; font-size: 17rpx; background: #f7ebda; }
.month-number { color: #95734e; font-size: 28rpx; font-family: Georgia, serif; }
.day-headings, .day-columns { display: flex; flex: 1; min-width: 0; }
.day-heading { position: relative; display: flex; flex: 1; min-width: 0; align-items: center; justify-content: center; flex-direction: column; gap: 6rpx; }
.weekday-name { color: #7d8d98; font-size: 18rpx; line-height: 1.3; }
.day-number { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; border-radius: 50%; color: #415c42; font-size: 27rpx; line-height: 42rpx; font-family: Georgia, serif; }
.is-today .weekday-name { color: #496a8b; }
.is-today .day-number { color: #34516b; background: #dceaf7; }
.today-mark { position: absolute; bottom: 8rpx; width: 5rpx; height: 5rpx; border-radius: 50%; background: transparent; }
.is-today .today-mark { background: #c07854; }
.outside-term { opacity: .38; }
.grid-body { position: relative; display: flex; }
.time-axis { position: relative; flex: 0 0 80rpx; width: 80rpx; background: #faf6ef; }
.axis-row { position: absolute; left: 0; width: 100%; display: flex; align-items: center; justify-content: flex-start; flex-direction: column; padding: 12rpx 2rpx 0; border-bottom: 1rpx solid #e8e5de; overflow: hidden; }
.axis-label { margin-bottom: 8rpx; color: #657b5d; font-size: 24rpx; line-height: 1.2; }
.axis-time { color: #7b8b71; font-size: 20rpx; line-height: 1.45; font-variant-numeric: tabular-nums; }
.break-axis { justify-content: center; padding-top: 0; background: #f0eee7; }
.break-axis .axis-label { margin-bottom: 0; color: #9ca58f; font-size: 15rpx; }
.day-column { position: relative; flex: 1; min-width: 0; border-left: 1rpx solid #e8e5de; }
.today-column { background: #f2f6fb; }
.outside-column { background: #f0efeb; }
.grid-cell { position: absolute; left: 0; width: 100%; border-bottom: 1rpx solid #e8e5de; }
.break-cell { background: #f2f0ea; }
.slot-pressed { background: #e3edf8; }
.lesson-block { position: absolute; z-index: 2; padding: 3rpx 2rpx; overflow: hidden; }
/* 雾蓝、浅薰衣草、杏色、玫瑰粉、蓝紫、冰川青：课程用浅底深字。 */
.lesson-inner { position: relative; height: 100%; overflow: hidden; padding: 10rpx 7rpx 8rpx; border-radius: 10rpx; background: #dceaf7; color: #34516b; }
.lesson-accent { position: absolute; left: 0; top: 10rpx; bottom: 10rpx; width: 3rpx; border-radius: 3rpx; background: #80abcf; }
.lesson-name { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 4; font-size: 21rpx; line-height: 1.43; font-weight: 600; word-break: break-all; }
.lesson-location { display: -webkit-box; margin-top: 9rpx; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; font-size: 17rpx; line-height: 1.45; word-break: break-all; }
.adjusted-tag { display: inline-block; margin-top: 8rpx; padding: 1rpx 5rpx; color: #996b46; background: #fffaf0; border-radius: 4rpx; font-size: 15rpx; line-height: 1.5; }
.adjusted-dot { position: absolute; right: 4rpx; top: 4rpx; width: 7rpx; height: 7rpx; border-radius: 50%; background: #b77a50; }
.color-1 .lesson-inner { background: #ece4f5; color: #5b4870; }
.color-1 .lesson-accent { background: #ac94c3; }
.color-2 .lesson-inner { background: #f7e7d2; color: #755735; }
.color-2 .lesson-accent { background: #d2aa77; }
.color-3 .lesson-inner { background: #f4e0e4; color: #794c59; }
.color-3 .lesson-accent { background: #cc98a5; }
.color-4 .lesson-inner { background: #e3e7f5; color: #4e5d83; }
.color-4 .lesson-accent { background: #98a7d2; }
.color-5 .lesson-inner { background: #ddeff0; color: #3c6267; }
.color-5 .lesson-accent { background: #87b9be; }
.short-card .lesson-name { -webkit-line-clamp: 2; }
.short-card .lesson-location { margin-top: 6rpx; -webkit-line-clamp: 1; }
.compact-card .lesson-inner { padding-top: 5rpx; padding-bottom: 4rpx; }
.compact-card .lesson-name { -webkit-line-clamp: 2; font-size: 19rpx; line-height: 1.3; }
.tiny-card .lesson-inner { padding-top: 1rpx; padding-bottom: 0; }
.tiny-card .lesson-name { display: block; text-overflow: ellipsis; white-space: nowrap; line-height: 1.5; }
.lesson-pressed { opacity: .72; }
.is-disabled { opacity: .72; }
.grid-caption { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 17rpx 2rpx; color: #8b957f; font-size: 19rpx; line-height: 1.6; }
.adjusted-legend { display: flex; flex-shrink: 0; align-items: center; gap: 7rpx; }
.legend-dot { width: 7rpx; height: 7rpx; border-radius: 50%; background: #b77a50; }
.empty-week-note { padding: 6rpx 4rpx 18rpx; color: #84927b; font-size: 23rpx; line-height: 1.7; }
.week-changes { margin-top: 13rpx; padding: 21rpx 23rpx 6rpx; border: 1rpx solid #e8d9c9; border-radius: 18rpx; background: #fcf3e8; }
.changes-heading { display: flex; justify-content: space-between; align-items: center; padding-bottom: 10rpx; font-size: 24rpx; color: #687a61; }
.changes-count { font-size: 20rpx; color: #98a08d; }
.change-row { display: flex; align-items: flex-start; gap: 15rpx; padding: 20rpx 0; border-top: 1rpx solid #e0e2d5; }
.change-status { flex-shrink: 0; margin-top: 2rpx; padding: 4rpx 9rpx; background: #e3e4da; color: #858a78; border-radius: 6rpx; font-size: 19rpx; line-height: 1.4; }
.leave-status { background: #ece2cd; color: #9b8059; }
.change-copy { flex: 1; min-width: 0; }
.change-name { display: block; color: #65765e; font-size: 24rpx; line-height: 1.5; word-break: break-all; }
.change-time, .change-note { display: block; margin-top: 4rpx; color: #98a08d; font-size: 20rpx; line-height: 1.5; }
.change-note { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.change-arrow { flex-shrink: 0; padding-top: 2rpx; font-size: 26rpx; color: #87967b; }
.change-pressed { opacity: .6; }
