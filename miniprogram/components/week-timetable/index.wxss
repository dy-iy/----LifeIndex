:host { display: block; }
view, text { box-sizing: border-box; }
.week-timetable { color: #183844; }
.grid-toolbar { padding: 4rpx 1rpx 19rpx; }
.grid-count { display: flex; align-items: center; gap: 10rpx; font-size: 21rpx; color: #879087; }
.arrangement-mark { width: 13rpx; height: 13rpx; border: 1rpx solid #b79acb; border-radius: 3rpx; background: #eee2f2; transform: rotate(-8deg); }
.grid-frame { overflow: hidden; border: 1rpx solid #ebdfce; border-radius: 12rpx 16rpx 11rpx 14rpx; background: #fffdf8; box-shadow: 0 5rpx 12rpx rgba(132, 102, 63, .07), 0 1rpx 3rpx rgba(132, 102, 63, .06); }
.grid-scroll { width: 100%; }
.timetable-sheet { width: 100%; }
.grid-heading { display: flex; height: 112rpx; background: #fbf7ee; border-bottom: 1rpx solid #e9e0d3; }
.month-heading { display: flex; flex-direction: column; justify-content: center; align-items: center; flex: 0 0 80rpx; width: 80rpx; gap: 1rpx; color: #8d7b98; font-size: 17rpx; background: #f1e9f3; }
.month-number { color: #685775; font-size: 28rpx; font-family: Georgia, serif; }
.day-headings, .day-columns { display: flex; flex: 1; min-width: 0; }
.day-heading { position: relative; display: flex; flex: 1; min-width: 0; align-items: center; justify-content: center; flex-direction: column; gap: 6rpx; }
.weekday-name { color: #879087; font-size: 18rpx; line-height: 1.3; }
.day-number { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; border-radius: 50%; color: #52675f; font-size: 27rpx; line-height: 42rpx; font-family: Georgia, serif; }
.is-today .weekday-name { color: #685775; }
.is-today .day-number { color: #183844; background: #eee1f2; border-radius: 46% 54% 48% 52%; box-shadow: 0 0 0 2rpx rgba(188, 151, 213, .35); }
.today-mark { position: absolute; bottom: 8rpx; width: 5rpx; height: 5rpx; border-radius: 50%; background: transparent; }
.is-today .today-mark { background: #b584d5; }
.outside-term { opacity: .38; }
.grid-body { position: relative; display: flex; }
.time-axis { position: relative; flex: 0 0 80rpx; width: 80rpx; background: #fbf7ef; }
.axis-row { position: absolute; left: 0; width: 100%; display: flex; align-items: center; justify-content: flex-start; flex-direction: column; padding: 12rpx 2rpx 0; border-bottom: 1rpx solid #eee6da; overflow: hidden; }
.axis-label { margin-bottom: 8rpx; color: #687c70; font-size: 24rpx; line-height: 1.2; }
.axis-time { color: #889289; font-size: 20rpx; line-height: 1.45; font-variant-numeric: tabular-nums; }
.break-axis { justify-content: center; padding-top: 0; background: #f4f0e8; }
.break-axis .axis-label { margin-bottom: 0; color: #92998d; font-size: 15rpx; }
.day-column { position: relative; flex: 1; min-width: 0; border-left: 1rpx solid #eee6da; }
.today-column { background: #faf5fb; }
.outside-column { background: #f3f0e9; }
.grid-cell { position: absolute; left: 0; width: 100%; border-bottom: 1rpx solid #eee6da; }
.break-cell { background: #f6f2eb; }
.slot-pressed { background: #eee1f3; }
.lesson-block { position: absolute; z-index: 2; padding: 3rpx 2rpx; overflow: hidden; }
/* 六种浅色便签保留课程区分，深字和侧边色线在窄列内仍清晰。 */
.lesson-inner { position: relative; height: 100%; overflow: hidden; padding: 10rpx 7rpx 8rpx; border-radius: 6rpx 9rpx 7rpx 8rpx; background: #e7eddf; color: #4d654d; box-shadow: inset 0 0 0 1rpx rgba(111, 95, 76, .045); }
.lesson-accent { position: absolute; left: 0; top: 10rpx; bottom: 10rpx; width: 3rpx; border-radius: 3rpx; background: #a7bb8e; }
.lesson-name { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 4; font-size: 21rpx; line-height: 1.43; font-weight: 600; word-break: break-all; }
.lesson-location { display: -webkit-box; margin-top: 9rpx; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; font-size: 17rpx; line-height: 1.45; word-break: break-all; }
.adjusted-tag { display: inline-block; margin-top: 8rpx; padding: 1rpx 5rpx; color: #996b46; background: #fffaf0; border-radius: 4rpx; font-size: 15rpx; line-height: 1.5; }
.adjusted-dot { position: absolute; right: 4rpx; top: 4rpx; width: 7rpx; height: 7rpx; border-radius: 50%; background: #b77a50; }
.color-1 .lesson-inner { background: #eee4f3; color: #655174; }
.color-1 .lesson-accent { background: #ac94c3; }
.color-2 .lesson-inner { background: #f6ead6; color: #755c3f; }
.color-2 .lesson-accent { background: #d2aa77; }
.color-3 .lesson-inner { background: #f4e3e7; color: #794f5b; }
.color-3 .lesson-accent { background: #cc98a5; }
.color-4 .lesson-inner { background: #e8e8f3; color: #565c7c; }
.color-4 .lesson-accent { background: #98a7d2; }
.color-5 .lesson-inner { background: #e0eeea; color: #426963; }
.color-5 .lesson-accent { background: #87b9be; }
.short-card .lesson-name { -webkit-line-clamp: 2; }
.short-card .lesson-location { margin-top: 6rpx; -webkit-line-clamp: 1; }
.compact-card .lesson-inner { padding-top: 5rpx; padding-bottom: 4rpx; }
.compact-card .lesson-name { -webkit-line-clamp: 2; font-size: 19rpx; line-height: 1.3; }
.tiny-card .lesson-inner { padding-top: 1rpx; padding-bottom: 0; }
.tiny-card .lesson-name { display: block; text-overflow: ellipsis; white-space: nowrap; line-height: 1.5; }
.lesson-pressed { opacity: .72; }
.is-disabled { opacity: .72; }
.grid-caption { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 17rpx 2rpx; color: #879087; font-size: 19rpx; line-height: 1.6; }
.adjusted-legend { display: flex; flex-shrink: 0; align-items: center; gap: 7rpx; }
.legend-dot { width: 7rpx; height: 7rpx; border-radius: 50%; background: #b77a50; }
.empty-week-note { padding: 6rpx 4rpx 18rpx; color: #879087; font-size: 23rpx; line-height: 1.7; }
.week-changes { margin-top: 13rpx; padding: 21rpx 23rpx 6rpx; border: 1rpx solid #e9dfd2; border-radius: 12rpx 16rpx 11rpx 14rpx; background: #fffaf1; box-shadow: 0 4rpx 10rpx rgba(132, 102, 63, .04); }
.changes-heading { display: flex; justify-content: space-between; align-items: center; padding-bottom: 10rpx; font-size: 24rpx; color: #183844; }
.changes-count { font-size: 20rpx; color: #969d92; }
.change-row { display: flex; align-items: flex-start; gap: 15rpx; padding: 20rpx 0; border-top: 1rpx dashed #e9dfd2; }
.change-status { flex-shrink: 0; margin-top: 2rpx; padding: 4rpx 9rpx; background: #eee7f1; color: #877094; border-radius: 6rpx; font-size: 19rpx; line-height: 1.4; }
.leave-status { background: #f4e8d1; color: #9b8059; }
.change-copy { flex: 1; min-width: 0; }
.change-name { display: block; color: #52675f; font-size: 24rpx; line-height: 1.5; word-break: break-all; }
.change-time, .change-note { display: block; margin-top: 4rpx; color: #879087; font-size: 20rpx; line-height: 1.5; }
.change-note { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.change-arrow { flex-shrink: 0; padding-top: 2rpx; font-size: 26rpx; color: #9d86b0; }
.change-pressed { opacity: .6; }
