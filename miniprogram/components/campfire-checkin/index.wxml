<view class="campfire-checkin {{animating ? 'campfire-checkin-active' : ''}}">
  <checkin-calendar group-id="{{groupId}}" context-key="{{calendarContext}}" month="{{calendarMonth}}"
    selected-date="{{day}}" created-date="{{createdDate}}" today-date="{{todayDate}}" days="{{calendarDays}}"
    loading="{{calendarLoading}}" error="{{calendarError}}" active="{{animating && !submitting}}"
    bind:datechange="selectCalendarDate" bind:monthchange="changeCalendarMonth" bind:retry="retryCalendar" />
  <view class="campfire-card">
    <view class="campfire-summary">
      <view class="campfire-stage-copy">
        <view class="campfire-badges">
          <text class="campfire-date">{{dateLabel}}</text>
          <text wx:if="{{ready && (scene.isFull || fullAchieved)}}" class="campfire-full-tag">{{scene.isFull ? '✨ 全员满卡' : '✨ 已达成全员满卡'}}</text>
        </view>
        <text class="campfire-subtitle">{{ready ? scene.subtitle : (loading ? '正在读取成员打卡进度…' : '打卡进度暂未加载')}}</text>
        <text class="campfire-title">{{scene.title}}</text>
      </view>
      <view class="campfire-progress-ring" role="progressbar" aria-label="成员打卡进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{percent}}">
        <image wx:if="{{scene.progressRingSrc}}" class="campfire-ring-image" src="{{scene.progressRingSrc}}" mode="scaleToFill" aria-hidden="true"/>
        <view wx:if="{{ready && scene.progressRingMaskSrc}}" class="campfire-ring-liquid" style="-webkit-mask-image: url('{{scene.progressRingMaskSrc}}'); mask-image: url('{{scene.progressRingMaskSrc}}');" aria-hidden="true">
          <view class="campfire-ring-flow"/>
          <view class="campfire-ring-shimmer"/>
          <view class="campfire-ring-stars">
            <view class="campfire-ring-star campfire-ring-star-one"/>
            <view class="campfire-ring-star campfire-ring-star-two"/>
            <view class="campfire-ring-star campfire-ring-star-three"/>
            <view class="campfire-ring-star campfire-ring-star-four"/>
            <view class="campfire-ring-star campfire-ring-star-five"/>
            <view class="campfire-ring-star campfire-ring-star-six"/>
          </view>
        </view>
        <view class="campfire-percent"><text class="campfire-percent-number">{{ready ? percent : '—'}}</text><text wx:if="{{ready}}" class="campfire-percent-unit">%</text></view>
      </view>
    </view>
    <view class="campfire-scene" aria-label="篝火夜读，已点亮{{completed}}盏营灯，共{{total}}盏">
      <image wx:if="{{scene.backgroundSrc}}" class="campfire-layer" src="{{scene.backgroundSrc}}" mode="scaleToFill" aria-hidden="true"/>
      <image wx:if="{{scene.auroraSrc}}" class="campfire-layer campfire-aurora {{scene.isFull ? 'campfire-layer-visible' : ''}}" src="{{scene.auroraSrc}}" mode="scaleToFill" aria-hidden="true"/>
      <image wx:if="{{scene.decorSrc}}" class="campfire-layer" src="{{scene.decorSrc}}" mode="scaleToFill" aria-hidden="true"/>
      <image wx:if="{{scene.glowSrc}}" class="campfire-layer campfire-glow" src="{{scene.glowSrc}}" mode="scaleToFill" aria-hidden="true"/>
      <image wx:if="{{scene.fireSrc}}" class="campfire-layer campfire-flame {{completed > 0 ? 'campfire-layer-visible' : ''}}" src="{{scene.fireSrc}}" mode="scaleToFill" aria-hidden="true"/>
      <image wx:if="{{scene.fireCoreSrc}}" class="campfire-layer campfire-flame-core campfire-layer-visible" src="{{scene.fireCoreSrc}}" mode="scaleToFill" aria-hidden="true"/>
      <image wx:if="{{scene.sparksBackSrc}}" class="campfire-layer campfire-sparks campfire-sparks-back" src="{{scene.sparksBackSrc}}" mode="scaleToFill" aria-hidden="true"/>
      <image wx:if="{{scene.sparksFrontSrc}}" class="campfire-layer campfire-sparks campfire-sparks-front" src="{{scene.sparksFrontSrc}}" mode="scaleToFill" aria-hidden="true"/>
      <image wx:if="{{scene.sceneSrc}}" class="campfire-layer" src="{{scene.sceneSrc}}" mode="scaleToFill" aria-hidden="true"/>
      <text wx:if="{{ready && scene.isFull}}" class="campfire-full-banner">🌌 篝火夜读 · 全员满卡</text>
    </view>
    <view wx:if="{{ready && reward}}" class="campfire-reward">
      <view class="campfire-reward-summary"><text class="campfire-reward-title">全员满卡，共学奖励</text><text class="campfire-reward-points">+{{rewardPoints}} 点</text></view>
      <text class="campfire-reward-description">按当日昨收的 3% 发放，已计入群指数</text>
    </view>
    <text wx:if="{{error}}" class="campfire-error" role="alert">{{error}}</text>
    <text wx:if="{{historyNotice}}" class="campfire-history-notice">{{historyNotice}}</text>
  </view>
  <view class="campfire-members-card">
    <view class="campfire-members-header">
      <text class="campfire-members-title">成员打卡</text>
      <view class="campfire-members-count"><view class="campfire-members-icon" aria-hidden="true"><view class="campfire-members-icon-head"/><view class="campfire-members-icon-head campfire-members-icon-head-secondary"/><view class="campfire-members-icon-body"/><view class="campfire-members-icon-body campfire-members-icon-body-secondary"/></view><text>{{total}} 位成员</text></view>
    </view>
    <view wx:if="{{memberRows.length}}" class="campfire-members-list">
      <view wx:for="{{memberRows}}" wx:key="id" class="campfire-member-row">
        <view class="campfire-member-avatar-wrap">
          <image wx:if="{{item.avatarSrc}}" class="campfire-member-avatar" src="{{item.avatarSrc}}" mode="aspectFill" data-id="{{item.id}}" data-src="{{item.avatarSrc}}" binderror="memberAvatarError"/>
          <view wx:else class="campfire-member-avatar campfire-member-avatar-fallback"><text>{{item.initial}}</text></view>
          <view wx:if="{{ready && membersReady && item.checked}}" class="campfire-member-avatar-check" aria-label="已打卡">✓</view>
        </view>
        <view class="campfire-member-copy">
          <view class="campfire-member-name-row"><text class="campfire-member-name">{{item.name}}</text><text wx:if="{{item.isSelf}}" class="campfire-member-self">我</text></view>
          <text class="campfire-member-subtitle">{{!ready || !membersReady ? (loading ? '正在读取打卡状态…' : '打卡状态待更新') : item.checked ? (item.timeLabel ? item.timeLabel + ' 完成打卡' : '已完成当天的打卡') : viewingHistory ? '当天未打卡' : '等待今天的打卡'}}</text>
        </view>
        <view class="campfire-member-action {{memberCheckinCelebrating && item.isSelf ? 'campfire-member-action-celebrating' : ''}}">
          <button size="mini" class="campfire-member-button {{ready && membersReady && item.checked ? 'campfire-member-button-checked' : ready && membersReady && item.isSelf && !viewingHistory ? 'campfire-member-button-self' : 'campfire-member-button-pending'}} {{submitting && item.isSelf && !item.checked ? 'campfire-member-button-submitting' : ''}} {{!ready || !membersReady || item.checked || !item.isSelf || viewingHistory || submitting ? 'campfire-member-button-disabled' : ''}}"
            data-id="{{item.id}}" data-group-id="{{groupId}}" data-day="{{day}}" bindtap="memberCheckin"
            disabled="{{!ready || !membersReady || item.checked || !item.isSelf || viewingHistory || submitting}}"
            aria-label="{{!ready || !membersReady ? (loading ? '正在加载打卡状态' : '打卡状态待更新') : item.checked ? item.name + '，已打卡' : item.isSelf && !viewingHistory ? (submitting ? '正在打卡' : '立即打卡') : item.name + '，未打卡'}}"
            hover-class="campfire-member-button-pressed" hover-stay-time="{{120}}">
            <view class="campfire-member-button-surface">
              <view class="campfire-member-button-content">
                <view class="campfire-member-clock" aria-hidden="true"/>
                <view class="campfire-member-button-spinner" aria-hidden="true"/>
                <text>{{!ready || !membersReady ? (loading ? '加载中…' : '状态待更新') : item.checked ? '已打卡' : item.isSelf && !viewingHistory ? (submitting ? '打卡中' : '打卡') : '未打卡'}}</text>
              </view>
              <view class="campfire-member-button-check" aria-hidden="true"/>
            </view>
          </button>
          <view wx:if="{{memberCheckinCelebrating && item.isSelf}}" class="campfire-member-checkin-effects" aria-hidden="true">
            <view class="campfire-member-checkin-halo"/>
            <view wx:for="{{memberCheckinParticles}}" wx:for-item="particle" wx:key="id" class="campfire-member-checkin-particle" style="{{particle.style}}"/>
          </view>
        </view>
      </view>
    </view>
    <text wx:else class="campfire-members-empty">{{loading ? '正在加载成员…' : viewingHistory && ready ? '这一天暂无成员记录' : '成员列表暂未加载'}}</text>
  </view>
</view>
