:host { display: block; width: 100%; min-width: 0; }
.index-card { position: relative; box-sizing: border-box; padding: 22rpx 24rpx 24rpx; overflow: hidden; border: 1rpx solid rgba(221, 213, 196, .72); border-radius: 32rpx; background-color: #fffdf7; background-image: radial-gradient(rgba(149, 119, 73, .048) .55px, transparent 1px); background-size: 7rpx 7rpx; color: #253d35; box-shadow: 0 8rpx 26rpx rgba(74, 58, 38, .06); font-family: "PingFang SC", "Microsoft YaHei", sans-serif; }
.card-quote, .period-tabs, .chart-frame, .chart-tools { position: relative; z-index: 1; }
.card-reading { display: flex; align-items: baseline; gap: 12rpx; padding-right: 54rpx; }
.card-price { flex-shrink: 0; color: #737b80; font-family: Georgia, "Times New Roman", serif; font-size: 94rpx; font-weight: 700; line-height: 1.02; letter-spacing: -2rpx; font-variant-numeric: tabular-nums; white-space: nowrap; }
.card-price--compact { font-size: 72rpx; }
.card-price--long { font-size: 52rpx; }
.card-unit { flex-shrink: 0; color: #839188; font-size: 23rpx; }
.card-change { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 42rpx; row-gap: 10rpx; margin-top: 9rpx; color: #737b80; font-family: Georgia, "Times New Roman", serif; font-size: 40rpx; line-height: 1.18; font-weight: 700; font-variant-numeric: tabular-nums; }
.card-points { display: flex; flex: 0 0 auto; align-items: baseline; gap: 9rpx; white-space: nowrap; }
.card-points-value { flex-shrink: 0; white-space: nowrap; }
.change-unit { flex-shrink: 0; color: #839188; font-family: "PingFang SC", sans-serif; font-size: 22rpx; font-weight: 400; }
.card-percent { flex: 0 0 auto; white-space: nowrap; }
.change-value--compact { font-size: 32rpx; }
.change-value--long { font-size: 26rpx; }
.quote--rise .card-price, .quote--rise .card-change { color: #e53935; }
.quote--fall .card-price, .quote--fall .card-change { color: #15945e; }
.period-tabs { display: flex; margin-top: 20rpx; margin-bottom: 18rpx; }
.period-tabs .period-tab { position: relative; box-sizing: border-box; display: flex; align-items: center; justify-content: center; flex: 0 0 25%; width: 25%; min-width: 0; height: 55rpx; margin: 0; padding: 0 0 8rpx; border: 0; border-radius: 0; background: transparent; color: #8b958e; font-size: 26rpx; line-height: 1.3; letter-spacing: 2rpx; }
.period-tabs .period-tab::after, .chart-error button::after { border: 0; }
.period-tabs .period-tab + .period-tab { border-left: 1rpx solid #e8e0d4; }
.period-tabs .period-tab[disabled] { background: transparent; color: #8b958e; }
.period-tabs .period-tab--active, .period-tabs .period-tab--active[disabled] { color: #253d35; font-weight: 600; }
.period-underline { position: absolute; right: 32%; bottom: 2rpx; left: 32%; height: 5rpx; border-radius: 50%; background: #bf91d9; transform: rotate(-2deg); }
.period-underline::after { position: absolute; right: -6rpx; bottom: -4rpx; left: 2rpx; height: 2rpx; border-radius: 50%; background: rgba(191, 145, 217, .4); content: ""; }
.chart-frame { padding: 10rpx 10rpx 0; border: 1rpx solid #e9e3d9; border-radius: 20rpx; background: rgba(255, 255, 255, .8); box-shadow: 0 3rpx 12rpx rgba(85, 61, 38, .035); }
.chart-stage { position: relative; height: 324rpx; overflow: hidden; border-radius: 12rpx; background: #fff; }
.chart-scroll, .chart-plot { position: relative; height: 324rpx; }
.chart-scroll { display: block; width: 100%; }
.plot-grid { position: absolute; left: 104rpx; right: 44rpx; height: 1rpx; border-top: 1rpx dashed #e9eceb; }
.intraday-line { position: absolute; top: 0; left: 0; height: 273rpx; pointer-events: none; }
.time-axis { position: absolute; top: 273rpx; right: 0; bottom: 0; left: 0; }
.plot-label { position: absolute; top: 3rpx; width: 84rpx; color: #879087; font-size: 19rpx; line-height: 36rpx; text-align: center; white-space: nowrap; }
.chart-axis { position: absolute; z-index: 3; top: 0; left: 0; width: 104rpx; height: 273rpx; background: #fff; pointer-events: none; }
.axis-label { position: absolute; left: 6rpx; color: #879087; font-size: 19rpx; line-height: 28rpx; font-variant-numeric: tabular-nums; transform: translateY(-50%); }
.axis-label.rise { color: #e53935; }
.axis-label.fall { color: #15945e; }
.candle-hit { position: absolute; top: 0; height: 273rpx; }
.candle-selected { background: rgba(57, 125, 167, .05); }
.candle-wick { position: absolute; width: 2rpx; background: currentColor; }
.candle-body { position: absolute; box-sizing: border-box; background: currentColor; }
.candle-body.rise { border: 2rpx solid #e53935; background: #fff; }
.candle-body.fall { color: #15945e; }
.candle-body.flat { color: #737b80; }
.crosshair-v { position: absolute; z-index: 4; top: 17rpx; height: 263rpx; border-left: 1rpx solid #8c9ca3; pointer-events: none; }
.crosshair-h { position: absolute; z-index: 4; border-top: 1rpx solid #8c9ca3; pointer-events: none; }
.crosshair-price, .crosshair-date { position: absolute; z-index: 5; border-radius: 4rpx; background: #597b77; color: #fff; font-size: 19rpx; line-height: 34rpx; text-align: center; font-variant-numeric: tabular-nums; pointer-events: none; }
.crosshair-price { left: 1rpx; width: 102rpx; }
.crosshair-date { top: 276rpx; }
.crosshair-dot { position: absolute; z-index: 5; width: 10rpx; height: 10rpx; border: 2rpx solid #fff; border-radius: 50%; background: #597b77; pointer-events: none; }
.chart-empty { position: absolute; top: 122rpx; right: 14rpx; left: 14rpx; color: #939d94; font-size: 25rpx; line-height: 1.6; text-align: center; }
.chart-loading { position: absolute; z-index: 7; top: 6rpx; right: 8rpx; padding: 3rpx 8rpx; border-radius: 5rpx; background: rgba(255, 255, 255, .94); color: #879087; font-size: 20rpx; line-height: 28rpx; pointer-events: none; }
.candle-detail { position: absolute; z-index: 6; top: 0; right: 3rpx; max-width: calc(100% - 104rpx); padding: 3rpx 8rpx; border-radius: 5rpx; background: rgba(255, 255, 255, .95); color: #718279; font-size: 18rpx; line-height: 24rpx; text-align: right; font-variant-numeric: tabular-nums; pointer-events: none; }
.chart-error { display: flex; align-items: center; gap: 10rpx; padding: 4rpx 6rpx 10rpx; color: #a67465; font-size: 21rpx; line-height: 1.5; }
.chart-error > text { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.chart-error button { flex-shrink: 0; width: auto; min-width: 0; margin: 0; padding: 6rpx 12rpx; background: transparent; color: #597b77; font-size: 21rpx; line-height: 1.5; }
.chart-tools { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; min-height: 76rpx; margin-top: 18rpx; }
.chart-help { flex: 1; min-width: 0; }
.chart-range { display: block; color: #69796f; font-size: 23rpx; line-height: 1.5; }
.chart-hint { display: block; margin-top: 4rpx; color: #8b958e; font-size: 20rpx; line-height: 1.5; }
.zoom-controls { display: flex; flex-shrink: 0; gap: 14rpx; }
.zoom-controls .zoom-button { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 64rpx; min-height: 0; height: 64rpx; margin: 0; padding: 0; border: 1rpx solid #dce1d8; border-radius: 12rpx; color: #496951; background: #f5f6ef; font-size: 37rpx; font-weight: 400; line-height: 1; }
.zoom-controls .zoom-button::after { border: 0; }
.zoom-controls .zoom-button[disabled] { color: #b2b9af; background: #f5f5ef; }
.zoom-button-pressed { opacity: .65; }
.card-paper-corner { position: absolute; top: -34rpx; right: -64rpx; width: 205rpx; height: 234rpx; border-radius: 20% 0 45% 50%; background: rgba(224, 200, 239, .22); transform: rotate(-17deg); pointer-events: none; }
.card-paper-corner::after { position: absolute; top: 72rpx; left: 8rpx; width: 156rpx; height: 92rpx; border: 2rpx solid rgba(188, 146, 214, .35); border-radius: 50%; transform: rotate(-42deg); content: ""; }
.card-spark { position: absolute; top: 29rpx; right: 159rpx; width: 5rpx; height: 23rpx; border-radius: 50%; background: #edc477; opacity: .7; pointer-events: none; }
.card-spark::after { position: absolute; top: 9rpx; left: -6rpx; width: 17rpx; height: 5rpx; border-radius: 50%; background: #edc477; content: ""; }
.card-bottom-curve { position: absolute; bottom: -43rpx; left: -55rpx; width: 390rpx; height: 65rpx; border-top: 2rpx solid rgba(186, 144, 219, .3); border-radius: 50%; transform: rotate(7deg); pointer-events: none; }
