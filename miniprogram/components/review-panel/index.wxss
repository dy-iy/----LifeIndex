@import "../../class-theme.wxss";

.review-heading { position: relative; display: flex; align-items: center; min-height: 90rpx; margin: 4rpx 0 16rpx; }
.review-art { position: absolute; width: 100rpx; height: 100rpx; right: 3rpx; top: -5rpx; }
.review-course { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 10rpx 18rpx; margin-top: 16rpx; padding: 22rpx; border: 1rpx solid #e7d8c6; border-radius: 20rpx; background: #f6ebdc; }
.review-course-name { font-size: 30rpx; overflow-wrap: anywhere; }
.review-course-meta { color: #889078; font-size: 22rpx; line-height: 1.7; }
.recorded-answers { margin-top: 20rpx; padding: 24rpx 22rpx; border: 1rpx solid #e3dfd7; border-radius: 20rpx; background: #fffdf9; }
.recorded-choice { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8rpx 18rpx; margin-top: 14rpx; font-size: 24rpx; line-height: 1.7; }
.recorded-label { color: #87917b; font-size: 23rpx; }
.recorded-focus { display: flex; flex-wrap: wrap; align-items: center; gap: 4rpx; color: #a7ac9b; }
.recorded-focus .lit { color: #d49a32; }
.recorded-focus-label { margin-left: 8rpx; color: #637955; font-size: 22rpx; }
.recorded-text, .recorded-answer { margin-top: 20rpx; }
.recorded-answer .answer-text { margin-top: 8rpx; }
.review-result { margin-top: 24rpx; padding: 32rpx 24rpx 46rpx; border: 1rpx solid #e3dfd7; border-radius: 24rpx; background: #fffdf9; text-align: center; }
.result-heading { color: #819073; font-size: 24rpx; }
.result-headline { margin: 32rpx 0 36rpx; font-size: 108rpx; font-weight: 600; line-height: 1.2; letter-spacing: 12rpx; text-indent: 12rpx; }
.result-label { color: #87917b; font-size: 23rpx; }
.result-percent { margin-top: 12rpx; font-size: 62rpx; line-height: 1.3; overflow-wrap: anywhere; }
.result-points { margin-top: 10rpx; font-size: 27rpx; }
.result-note { margin: -12rpx 0 26rpx; color: #87917b; font-size: 23rpx; line-height: 1.7; }
.review-result .rise { color: #b65042; }
.review-result .fall { color: #47785d; }
.review-result .flat { color: #718171; }
.review-status { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin: 20rpx 0; font-size: 22rpx; line-height: 1.7; color: #819073; }
.guide-link { display: block; color: #ba6949; margin-top: 7rpx; }
.review-status .guide-link { margin: 0; flex-shrink: 0; }
.review-error { margin: 20rpx 0; padding: 20rpx 24rpx; border: 1rpx solid #ebceba; border-radius: 16rpx; background: #fff2e8; color: #985b3f; font-size: 23rpx; line-height: 1.7; }
.review-error .primary-button { margin-top: 18rpx; }
.review-empty { margin: 30rpx 0; padding: 42rpx 28rpx; border: 1rpx solid #e3dfd7; border-radius: 24rpx; background: #fffdf9; text-align: center; }
.review-empty-title { font-size: 32rpx; font-family: "Songti SC", serif; }
.review-empty-text { margin: 20rpx 0 30rpx; color: #87917b; font-size: 24rpx; line-height: 1.8; }
.record-picker { display: flex; justify-content: space-between; gap: 12rpx; margin: 20rpx 0 12rpx; padding: 22rpx 28rpx 22rpx 22rpx; border: 1rpx solid #d8deca; border-radius: 16rpx; color: #637955; font-size: 24rpx; }
.question { display: flex; margin-top: 18rpx; padding: 20rpx 20rpx 14rpx; border: 1rpx solid #e3dfd7; border-radius: 24rpx; background: #fffdf9; }
.question-number { width: 56rpx; flex-shrink: 0; color: #bd744f; font-size: 30rpx; padding-top: 3rpx; }
.question-content { flex: 1; min-width: 0; }
.question-title { font-size: 28rpx; font-family: "Songti SC", serif; margin-bottom: 14rpx; }
.answer-input { box-sizing: border-box; width: 100%; min-height: 100rpx; padding: 16rpx 20rpx; font-size: 25rpx; line-height: 1.7; background: #f5f8fb; border: 1rpx solid #dbe4ea; border-radius: 4rpx 20rpx 20rpx; color: #234b3b; }
.answer-placeholder { color: #a8ac98; }
.answer-count { text-align: right; font-size: 18rpx; color: #a1aa92; padding: 9rpx 2rpx 0; }
.cloud-answer { margin-top: 16rpx; padding: 16rpx; background: #f6ebdc; border-radius: 12rpx; font-size: 24rpx; line-height: 1.7; white-space: pre-wrap; overflow-wrap: anywhere; }
.cloud-label { display: block; color: #985b3f; margin-bottom: 8rpx; }
.review-actions { margin-top: 24rpx; }
.review-footnote { text-align: center; line-height: 1.6; color: #889679; font-size: 22rpx; padding: 14rpx 0 22rpx; }
.disclosure-button { display: flex; align-items: center; justify-content: space-between; width: 100%; margin: 16rpx 0 0; padding: 22rpx 4rpx; border: 0; border-top: 1rpx solid #d8ddc8; border-radius: 0; background: transparent; color: #7d8972; text-align: left; font-size: 24rpx; line-height: 1.7; }
.disclosure-button::after { border: 0; }
.disclosure-button text { margin-left: 18rpx; font-size: 30rpx; }
.review-details { padding: 8rpx 4rpx 20rpx; }
.evaluation-card { margin-top: 24rpx; border: 1rpx solid #d6dfd3; border-radius: 24rpx; background: #f5f8f0; padding: 24rpx 22rpx; }
.evaluation-heading { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.evaluation-heading .guide-link { margin-top: 0; font-size: 23rpx; }
.evaluation-status { color: #5e7758; font-size: 32rpx; }
.evaluation-note { color: #7d8972; font-size: 23rpx; line-height: 1.8; margin: 12rpx 0; overflow-wrap: anywhere; }
.clarification { margin-top: 22rpx; padding-top: 22rpx; border-top: 1rpx solid #d6deca; }
.clarification .primary-button { margin-top: 16rpx; }
.score-total { display: flex; justify-content: space-between; align-items: center; font-size: 25rpx; padding: 22rpx 0; }
.score-total .serif { color: #395b44; font-size: 50rpx; }
.score-total .serif text { font-size: 23rpx; color: #8a997c; }
.score-dimension { padding: 21rpx 20rpx; margin: 10rpx 0; background: #fffdf9; border-radius: 16rpx; font-size: 25rpx; }
.score-dimension > text { display: block; color: #7d8972; font-size: 23rpx; line-height: 1.8; margin-top: 12rpx; white-space: pre-wrap; overflow-wrap: anywhere; }
.evaluation-version { color: #87957d; font-size: 19rpx; line-height: 1.9; margin-top: 18rpx; overflow-wrap: anywhere; }
.review-manager { padding-top: 22rpx; margin-top: 20rpx; border-top: 1rpx dashed #d1dac6; line-height: 1.8; font-size: 24rpx; color: #77826d; }
.review-manager text { display: block; overflow-wrap: anywhere; }
.manager-label { font-size: 25rpx; margin-bottom: 10rpx; }
.manager-label.bull { color: #b65042; }
.manager-label.bear { color: #47785d; }
.manager-label.neutral { color: #7b826c; }

:host { display: block; }
.review-panel-layout-window { display: flex; flex-direction: column; height: 100%; min-height: 0; }
.review-panel-layout-window .review-panel-body { flex: 1; height: 0; min-height: 0; border-radius: 0 0 30rpx 30rpx; overflow: hidden; }
.review-panel-embedded { padding: 0 24rpx 28rpx; }
.review-panel-embedded .review-course { margin-top: 0; }
.review-wizard .review-course { margin-top: 18rpx; padding: 16rpx 18rpx; }
.wizard-question { min-height: 210rpx; margin-top: 24rpx; padding: 24rpx 22rpx; border: 1rpx solid #e3dfd7; border-radius: 20rpx; background: #fffdf9; }
.wizard-question .question-title { margin-bottom: 20rpx; }
.wizard-question .focus-stars { justify-content: center; margin-top: 24rpx; }
.wizard-question .wizard-text-input { height: 220rpx; min-height: 220rpx; background: #faf8f2; border-color: #e3dfd7; border-radius: 14rpx; }
.wizard-text-placeholder { color: #a2a2a2; }
.wizard-navigation { display: flex; flex-shrink: 0; align-items: center; justify-content: space-between; gap: 18rpx; padding: 18rpx 24rpx 24rpx; }
.wizard-navigation .primary-button { flex: 0 0 180rpx; min-width: 0; margin: 0 0 0 auto; padding: 20rpx 0; font-size: 26rpx; line-height: 1.5; }
.wizard-navigation .wizard-previous { flex: 0 0 180rpx; margin: 0; padding: 20rpx 0; border: 1rpx solid #d8deca; border-radius: 999rpx; background: #fffdf9; color: #637955; font-size: 26rpx; line-height: 1.5; }
.wizard-previous::after { border: 0; }
.wizard-pagination { position: absolute; top: calc(100% + 20rpx); left: 0; right: 0; display: flex; align-items: center; justify-content: center; gap: 14rpx; height: 20rpx; }
.wizard-page-dot { width: 12rpx; height: 12rpx; flex-shrink: 0; border: 1rpx solid rgba(255, 255, 255, .85); border-radius: 50%; background: rgba(255, 255, 255, .35); }
.wizard-page-dot.active { background: #fffdf9; }
.review-tabs { display: flex; gap: 14rpx; margin: 18rpx 0; }
.review-tabs button { flex: 1; margin: 0; font-size: 26rpx; background: #fffdf9; color: #637955; border-radius: 18rpx; }
.review-tabs .selected, .review-choices .selected { background: #e1ebd8; color: #31543d; border-color: #81996d; }
.participation-card { margin-top: 20rpx; padding: 22rpx; border: 1rpx solid #e3dfd7; border-radius: 20rpx; background: #fffdf9; }
.review-choices { display: flex; flex-wrap: wrap; justify-content: center; gap: 12rpx; margin: 16rpx 0; }
.review-choices .choice { margin: 0; padding: 10rpx 18rpx; font-size: 23rpx; line-height: 1.7; border: 1rpx solid #d8deca; border-radius: 14rpx; background: #fffdf9; color: #637955; }
.review-choices .choice.selected { background: #e1ebd8; color: #31543d; border-color: #81996d; }
.review-choices .choice[disabled] { opacity: .7; }
.review-branch { margin-left: 20rpx; border-left: 4rpx solid #c9d7ba; }
.focus-stars { display: flex; flex-wrap: nowrap; align-items: center; gap: 8rpx; margin: 12rpx 0 6rpx; }
.focus-stars .focus-star { flex: 0 1 76rpx; min-width: 0; height: 84rpx; margin: 0; padding: 0; border: 0; border-radius: 12rpx; background: transparent; color: #a7ac9b; font-size: 64rpx; line-height: 84rpx; text-align: center; }
.focus-star::after { border: 0; }
.focus-star.lit, .focus-star.lit[disabled] { color: #d49a32; }
.focus-star[disabled] { background: transparent; color: #a7ac9b; opacity: 1; }
.answer-text { display: block; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 26rpx; line-height: 1.9; color: #38503d; }
.evaluation-card .primary-button { margin-top: 18rpx; }
