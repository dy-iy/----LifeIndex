/* Shared picker content; import explicitly in isolated components as well. */
.picker-trigger {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-width: 0;
  min-height: 72rpx;
  color: #3f554b;
  font-size: 26rpx;
  line-height: 1.5;
  text-align: left;
}
.picker-value {
  display: block;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.picker-detail { flex-shrink: 0; color: #697b70; font-size: 23rpx; white-space: nowrap; }
.picker-chevron {
  position: relative;
  box-sizing: border-box;
  display: block;
  flex: 0 0 36rpx;
  width: 36rpx;
  height: 36rpx;
  margin-right: 4rpx;
  color: #587060;
}
.picker-chevron::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  box-sizing: border-box;
  width: 18rpx;
  height: 18rpx;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  /* Center the visible V, whose strokes sit below the rotated square's center. */
  transform: translate(-50%, -75%) rotate(45deg);
}
.picker-chevron--up { transform: rotate(180deg); }
.picker-trigger--compact {
  min-height: 68rpx;
  padding: 12rpx 18rpx;
  border: 1rpx solid #d8dfd5;
  border-radius: 12rpx;
  background: #fffdf9;
  font-size: 24rpx;
}
.picker-disabled .picker-trigger { color: #7d867f; background: #f0f0ea; }
.picker-disabled .picker-chevron { color: #a0a89f; }
