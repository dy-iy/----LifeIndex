/* Background artwork: assets/art/page-garden.svg. Embedded for Mini Program compatibility. */
.page {
  background-color: #faf7f2;
  background-image: url("data:image/svg+xml;base64,"), linear-gradient(165deg, #faf7f2 40%, #f5f4f7 76%, #f1f6f7 100%);
  background-repeat: no-repeat;
  background-position: center top, center;
  background-size: 750rpx 1280rpx, 100% 100%;
}
