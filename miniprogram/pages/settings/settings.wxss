.profile-heading { display: flex; align-items: center; margin: 38rpx 0 37rpx; }.profile-monogram { position: relative; flex-shrink: 0; width: 112rpx; height: 112rpx; line-height: 112rpx; border-radius: 50%; text-align: center; border: 1rpx solid #bec8ad; font-size: 76rpx; background: #e9eddc; margin-right: 26rpx; }.profile-monogram text { position: absolute; right: -3rpx; bottom: -7rpx; font-family: sans-serif; font-size: 33rpx; color: #bc6948; line-height: 1; background: #f5f1e7; border-radius: 50%; }.profile-copy { min-width: 0; }.profile-title { font-family: "Songti SC", serif; font-size: 36rpx; line-height: 1.4; word-break: break-all; }.login-panel { padding-bottom: 0; }.profile-form { padding-top: 1rpx; border-top: 1rpx solid #d8dfcb; }.settings-list { border-top: 1rpx solid #d3dcc5; }.settings-row { display: flex; justify-content: space-between; align-items: center; padding: 29rpx 0; border-bottom: 1rpx solid #d3dcc5; font-size: 27rpx; }.row-arrow { color: #7f9270; font-size: 32rpx; }.session-actions { display: flex; justify-content: center; margin-top: 23rpx; }.session-actions button { margin: 0 16rpx; }.logout-button { color: #b87454; }.profile-footer { text-align: center; padding-top: 19rpx; }.profile-footer image { width: 170rpx; height: 170rpx; opacity: 0.8; }
.avatar-button { flex-shrink: 0; width: 116rpx; height: 116rpx; padding: 0; margin: 0 26rpx 0 0; overflow: visible; background: transparent; border-radius: 50%; line-height: normal; }.avatar-button::after { border: 0; }.avatar-button[disabled] { background: transparent; opacity: 0.65; }.avatar-button .profile-monogram { margin-right: 0; color: #263c32; }.profile-avatar { display: block; width: 112rpx; height: 112rpx; border: 1rpx solid #bec8ad; border-radius: 50%; }.avatar-hint { color: #7f9270; font-size: 22rpx; margin-top: 9rpx; }.avatar-retry { margin: 0 0 18rpx; padding-left: 0; text-align: left; }
.profile-form .secondary-button { margin-top: 28rpx; }
