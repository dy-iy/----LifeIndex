@import "../../review-window.wxss";

page { background: #fbf7ee; color: #102e46; }

.tp-page {
  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  overflow: hidden;
  padding: 30rpx 40rpx 156rpx;
  padding-bottom: calc(156rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(156rpx + env(safe-area-inset-bottom));
  background-color: #fbf7ee;
  background-image:
    radial-gradient(rgba(132, 101, 69, .045) .6px, transparent 1px),
    linear-gradient(118deg, rgba(255, 255, 255, .35), rgba(246, 235, 213, .12));
  background-size: 7rpx 7rpx, 100% 100%;
  color: #102e46;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.tp-main { position: relative; z-index: 1; width: 100%; max-width: 750rpx; margin: 0 auto; }
.tp-heading { position: relative; display: inline-block; max-width: 86%; padding: 5rpx 6rpx 15rpx; }
.tp-heading-text { position: relative; font-family: "Kaiti SC", "STKaiti", "KaiTi", "Songti SC", serif; font-size: 75rpx; font-weight: 900; line-height: 1.18; letter-spacing: -2rpx; }
.tp-title-stroke { position: absolute; left: -3rpx; right: -5rpx; bottom: 1rpx; height: 9rpx; border-radius: 46% 12% 43% 10%; background: #bc8ce9; transform: rotate(-2deg); box-shadow: 8rpx 8rpx 0 -2rpx rgba(177, 112, 234, .50); }
.tp-title-sparks { position: absolute; top: 5rpx; right: -37rpx; width: 9rpx; height: 27rpx; border-radius: 8rpx; background: #ac73ed; transform: rotate(26deg); }
.tp-title-sparks::after { position: absolute; top: 17rpx; left: 23rpx; width: 9rpx; height: 24rpx; border-radius: 8rpx; background: #ac73ed; transform: rotate(31deg); content: ""; }
.tp-heading-tape { position: absolute; top: -9rpx; left: -48rpx; width: 76rpx; height: 31rpx; background: rgba(189, 146, 230, .32); transform: rotate(-26deg); }

.tp-corner-paper { position: absolute; top: -17rpx; right: -41rpx; width: 220rpx; height: 210rpx; border-radius: 15% 0 0 49%; background: rgba(248, 223, 195, .30); transform: rotate(12deg); box-shadow: -2rpx 5rpx 7rpx rgba(165, 138, 100, .04); pointer-events: none; }
.tp-sun { position: absolute; top: 35rpx; left: 71rpx; width: 86rpx; height: 86rpx; border-radius: 48% 53% 46% 51%; background: rgba(247, 211, 120, .48); }
.tp-corner-line { position: absolute; top: 2rpx; left: 10rpx; width: 161rpx; height: 55rpx; border-bottom: 3rpx solid rgba(180, 133, 220, .35); border-radius: 50%; transform: rotate(-44deg); }

.tp-course { margin: 32rpx auto 0; text-align: center; }
.tp-course-title-wrap { position: relative; display: inline-block; max-width: 100%; padding: 0 12rpx 3rpx; box-sizing: border-box; }
.tp-course-title-wrap::before { position: absolute; right: 0; bottom: 2rpx; left: 0; height: 23rpx; border-radius: 45% 23% 45% 15%; background: rgba(214, 186, 236, .40); transform: rotate(-2deg); content: ""; }
.tp-course-title { position: relative; font-family: "Kaiti SC", "STKaiti", "KaiTi", "Songti SC", serif; font-size: 38rpx; font-weight: 700; line-height: 1.4; word-break: break-all; }
.tp-course-hint { display: block; margin-top: 12rpx; color: #698263; font-family: "Kaiti SC", "STKaiti", "KaiTi", "Songti SC", serif; font-size: 27rpx; font-weight: 600; line-height: 1.5; word-break: break-all; }
.tp-course-time { display: block; margin-top: 12rpx; color: #7d817c; font-size: 22rpx; line-height: 1.5; }
.tp-pencil-line { position: relative; width: 106rpx; height: 10rpx; margin: 8rpx auto 0; border-top: 2rpx solid #9ea6a8; border-radius: 50%; transform: rotate(-5deg); }
.tp-pencil-line::after { position: absolute; top: 0; left: 49rpx; width: 35rpx; height: 8rpx; border-bottom: 2rpx solid #9ea6a8; transform: rotate(-20deg); content: ""; }

.tp-dial-wrap { position: relative; width: 560rpx; max-width: 100%; margin: 33rpx auto 0; }
.tp-dial-wrap { border-radius: 50%; transition: transform .18s ease; -webkit-tap-highlight-color: transparent; }
.dial-pressed { transform: scale(.965); }
.dial-tap-a { animation: dial-tap-a .52s ease-out; }
.dial-tap-b { animation: dial-tap-b .52s ease-out; }
.dial-tap-ripple { position: absolute; z-index: 2; top: 0; right: 0; bottom: 0; left: 0; border: 3rpx solid #bc8ce9; border-radius: 50%; box-shadow: 0 0 20rpx rgba(188, 140, 233, .25); opacity: 0; pointer-events: none; }
.dial-tap-a .dial-tap-ripple { animation: dial-ripple-a .6s ease-out; }
.dial-tap-b .dial-tap-ripple { animation: dial-ripple-b .6s ease-out; }
@keyframes dial-tap-a { 0% { transform: scale(.98); } 24% { transform: scale(.965); } 60% { transform: scale(1.018); } 100% { transform: scale(1); } }
@keyframes dial-tap-b { 0% { transform: scale(.98); } 24% { transform: scale(.965); } 60% { transform: scale(1.018); } 100% { transform: scale(1); } }
@keyframes dial-ripple-a { 0% { opacity: .75; transform: scale(.94); } 35% { opacity: .5; } 100% { opacity: 0; transform: scale(1.12); } }
@keyframes dial-ripple-b { 0% { opacity: .75; transform: scale(.94); } 35% { opacity: .5; } 100% { opacity: 0; transform: scale(1.12); } }

.tp-stats {
  position: relative;
  display: flex;
  box-sizing: border-box;
  align-items: center;
  min-height: 140rpx;
  margin-top: 25rpx;
  padding: 21rpx 14rpx 24rpx;
  border: 2rpx solid #fffdf4;
  border-radius: 16rpx 11rpx 17rpx 12rpx;
  background-color: #fffaf0;
  background-image: radial-gradient(rgba(161, 126, 79, .055) .6px, transparent 1px);
  background-size: 7rpx 7rpx;
  box-shadow: 0 7rpx 12rpx rgba(130, 97, 58, .10), 0 1rpx 3rpx rgba(130, 97, 58, .05);
}

.tp-stats::after { position: absolute; right: 3rpx; bottom: -3rpx; left: 3rpx; height: 6rpx; background: radial-gradient(circle at 7rpx 7rpx, #fbf7ee 4rpx, transparent 5rpx); background-size: 14rpx 7rpx; content: ""; }
.tp-stats-tape { position: absolute; top: -7rpx; left: 15rpx; width: 86rpx; height: 25rpx; background: rgba(189, 146, 230, .35); transform: rotate(-18deg); }
.tp-stat { display: flex; flex: 1; flex-direction: column; align-items: center; min-width: 0; text-align: center; }
.tp-stat-label { color: #414d4b; font-family: "Kaiti SC", "STKaiti", "KaiTi", "Songti SC", serif; font-size: 27rpx; font-weight: 600; line-height: 1.5; }
.tp-stat-number { display: block; max-width: 100%; margin-top: 5rpx; color: #12314a; font-family: Georgia, "Times New Roman", serif; font-size: 44rpx; font-weight: 700; line-height: 1.2; word-break: break-all; }
.tp-stat-divider { flex: 0 0 2rpx; height: 67rpx; margin: 0 5rpx; background: #dec7a4; opacity: .72; }
.tp-plan-number { display: flex; align-items: baseline; justify-content: center; flex-wrap: wrap; max-width: 100%; }
.tp-stat-unit { margin-left: 8rpx; color: #414d4b; font-family: "Kaiti SC", "STKaiti", "KaiTi", "Songti SC", serif; font-size: 27rpx; line-height: 1.4; }

.tp-footer-art { position: relative; height: 182rpx; margin-top: 31rpx; pointer-events: none; }
.tp-purple-paper { position: absolute; bottom: -15rpx; left: -58rpx; width: 178rpx; height: 119rpx; border-radius: 13% 36% 0 0; background: rgba(216, 190, 235, .24); transform: rotate(-9deg); }
.tp-footer-curve { position: absolute; bottom: 33rpx; left: -74rpx; width: 575rpx; height: 95rpx; border-top: 3rpx solid rgba(173, 125, 216, .35); border-radius: 50%; transform: rotate(12deg); }
.tp-sprig { position: absolute; right: 22rpx; bottom: 0; width: 100rpx; height: 169rpx; transform: rotate(13deg); }
.tp-sprig-stem { position: absolute; bottom: 0; left: 39rpx; width: 26rpx; height: 147rpx; border-left: 3rpx solid #b1be9e; border-radius: 55% 0 0 0; transform: rotate(11deg); }
.tp-leaf { position: absolute; width: 34rpx; height: 62rpx; border: 3rpx solid #b1be9e; border-radius: 100% 0 100% 0; }
.tp-leaf--left { top: 58rpx; left: 0; height: 49rpx; transform: rotate(103deg); }
.tp-leaf--right { top: 2rpx; left: 48rpx; transform: rotate(5deg); }
.tp-footer-spark { position: absolute; top: 43rpx; right: -1rpx; width: 8rpx; height: 29rpx; border-radius: 60%; background: #c19ae7; }
.tp-footer-spark::after { position: absolute; top: 11rpx; left: -10rpx; width: 28rpx; height: 7rpx; border-radius: 60%; background: #c19ae7; content: ""; }

.timer-login { padding: 28rpx 10rpx 0; text-align: center; }
.timer-login .empty-copy { color: #7d817c; font-size: 23rpx; line-height: 1.8; }
.timer-login .empty-copy text { display: block; }
.timer-login .primary-button { width: 370rpx; max-width: 100%; margin: 22rpx auto 0; padding: 23rpx 28rpx; background: #7954a0; color: #fffaf0; border: 2rpx solid #69458f; box-shadow: 0 5rpx 12rpx rgba(115, 78, 147, .14); }
.tp-page--guest .tp-footer-art { height: 70rpx; margin-top: 18rpx; }
.tp-page--guest .tp-footer-curve { height: 60rpx; bottom: 0; }
.tp-page--guest .tp-purple-paper { height: 65rpx; }
.tp-page--guest .tp-sprig { height: 100rpx; transform: scale(.65) rotate(13deg); transform-origin: right bottom; }
.tp-page--guest .tp-footer-spark { top: 0; }
.timer-finalize { width: 390rpx; max-width: 100%; margin: 24rpx auto 0; color: #7954a0; border: 1rpx solid #d6bce7; border-radius: 40rpx; background: #f6ecf8; }
.sync-copy { padding-top: 20rpx; color: #7d817c; font-size: 22rpx; line-height: 1.6; text-align: center; }
.timer-progress { height: 6rpx; margin: 24rpx 30rpx 0; border-radius: 10rpx; overflow: hidden; background: #e8dfec; }
.timer-progress > view { height: 100%; border-radius: 10rpx; background: #ad83ce; transition: width .3s ease; }
.timer-hints { padding: 0 16rpx; }
.timing-hint { margin-top: 20rpx; color: #8b7356; font-size: 22rpx; line-height: 1.7; text-align: center; }
.timer-error { margin-top: 24rpx; padding: 20rpx 24rpx; border: 1rpx solid #ecd6c5; border-radius: 18rpx; background: #fff6ee; color: #a25d48; font-size: 23rpx; line-height: 1.7; overflow-wrap: anywhere; }
.timer-error .text-button { padding-bottom: 0; color: #a25d48; }
.pending-note { margin-top: 24rpx; padding: 24rpx; border: 1rpx solid #e8d7b2; border-radius: 18rpx; background: #fbf1da; color: #8a7147; font-size: 25rpx; line-height: 1.7; }
.pending-note text { display: block; margin-top: 10rpx; font-size: 22rpx; }
.pending-note .text-button { color: #8a7147; }

@media (max-height: 640px) {
  .tp-page { padding-top: 20rpx; }
  .tp-course { margin-top: 22rpx; }
  .tp-stats { margin-top: 17rpx; }
  .tp-footer-art { height: 110rpx; }
}

@media (prefers-reduced-motion: reduce) {
  .tp-dial-wrap, .timer-progress > view { transition: none; }
  .dial-pressed { transform: none; }
  .dial-tap-a, .dial-tap-b, .dial-tap-a .dial-tap-ripple, .dial-tap-b .dial-tap-ripple { animation: none; }
}
