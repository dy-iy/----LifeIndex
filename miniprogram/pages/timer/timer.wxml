<page-meta page-style="{{reviewOpen ? 'overflow: hidden;' : ''}}"/>
<view class="tp-page {{!loggedIn ? 'tp-page--guest' : ''}}">
  <view class="tp-corner-paper" aria-hidden="true">
    <view class="tp-sun"></view>
    <view class="tp-corner-line"></view>
  </view>

  <view class="tp-main">
    <view class="tp-heading">
      <view class="tp-heading-tape" aria-hidden="true"></view>
      <text class="tp-heading-text">上课计时</text>
      <view class="tp-title-stroke" aria-hidden="true"></view>
      <view class="tp-title-sparks" aria-hidden="true"></view>
    </view>

    <block wx:if="{{loggedIn}}">
      <view wx:if="{{error}}" class="timer-error"><view>{{error}}</view><button class="text-button" disabled="{{loading || busy}}" bindtap="reload">重新同步</button></view>
      <view wx:if="{{lessonError}}" class="timer-error"><view>{{lessonError}}</view><button class="text-button" disabled="{{loading || busy}}" bindtap="reload">重新同步课程</button></view>
      <view wx:if="{{finishNotice}}" class="pending-note">{{finishNotice}}</view>
      <view wx:if="{{loading}}" class="sync-copy">正在同步课程与计时…</view>
      <view wx:if="{{pendingFinish}}" class="pending-note"><view>已结束，待同步</view><text>点击时间已保存在本机，显示已停止。联网后自动同步；未送达的结束操作按点击时刻补记。</text><button wx:if="{{!course}}" class="text-button" disabled="{{loading || busy}}" bindtap="retryFinish">重新同步计时记录</button></view>
    </block>

    <view class="tp-course">
      <view class="tp-course-title-wrap">
        <text class="tp-course-title">{{!loggedIn ? '登录后开始计时' : course ? course.name : '当前无课程'}}</text>
      </view>
      <text wx:if="{{loggedIn && course}}" class="tp-course-time">{{course.local_date}} {{course.start_time}}–{{course.end_time}}</text>
      <text class="tp-course-hint" aria-live="polite">{{loggedIn ? dialStateLabel : '准备开始，让每一份投入被记录'}}</text>
      <view class="tp-pencil-line" aria-hidden="true"></view>
    </view>

    <!-- The existing page owns tap handling, guards and feedback; the dial only renders. -->
    <view class="tp-dial-wrap {{dialTapClass}}" bindtap="tapDial" hover-class="dial-pressed" hover-start-time="0" hover-stay-time="80" aria-role="button" aria-disabled="{{loggedIn && (busy || (loading && phase === 'idle') || reviewOpen || !dialEnabled)}}" aria-label="{{!loggedIn ? '登录后开始计时' : busy ? '正在处理' : (loading && phase === 'idle') ? '正在同步' : dialActionLabel}}">
      <view class="dial-tap-ripple" aria-hidden="true"></view>
      <timer-dial
        label="{{record && record.source === 'manual' ? '自报投入' : '课内有效时长'}}"
        time-text="{{elapsed}}"
        status-text="{{!loggedIn ? '点击登录，开始计时' : busy ? '正在处理…' : (loading && phase === 'idle') ? '正在同步…' : dialActionLabel}}"
        actionable="{{!loggedIn || (dialEnabled && !busy && !(loading && phase === 'idle'))}}"
        status-kind="{{!loggedIn ? 'play' : dialEnabled && !busy && !(loading && phase === 'idle') && !pendingFinish ? (canContinue || phase === 'idle' ? 'play' : (phase === 'running' || phase === 'paused') ? 'stop' : '') : ''}}"
      />
    </view>

    <button wx:if="{{loggedIn && canFinishForReview}}" class="text-button timer-finalize" disabled="{{busy || loading}}" bindtap="finish">结束计时并复盘</button>

    <view class="tp-stats">
      <view class="tp-stats-tape" aria-hidden="true"></view>
      <view class="tp-stat">
        <text class="tp-stat-label">课前准备</text>
        <text class="tp-stat-number">{{preparation}}</text>
      </view>
      <view class="tp-stat-divider" aria-hidden="true"></view>
      <view class="tp-stat">
        <text class="tp-stat-label">课程计划</text>
        <view class="tp-plan-number">
          <text class="tp-stat-number">{{plannedMinutes}}</text>
          <text class="tp-stat-unit">分钟</text>
        </view>
      </view>
    </view>

    <view wx:if="{{!loggedIn}}" class="timer-login">
      <view class="empty-copy">登录后，自动识别课表中的当前课程。<text>计时记录会保存在个人账户中。</text></view>
      <button class="primary-button" bindtap="goLogin">去「我的」登录</button>
    </view>
    <block wx:else>
      <view wx:if="{{record && record.source !== 'manual'}}" class="sync-copy">累计记录（含课前课后） {{totalElapsed}} · {{phaseLabel}}</view>
      <view wx:if="{{course}}" class="timer-progress" aria-label="课程进度 {{progress}}%"><view style="width: {{progress}}%;"></view></view>
      <view class="timer-hints">
        <view wx:if="{{pendingFinish}}" class="timing-hint">本机已停止，等待保存到云端。</view>
        <view wx:elif="{{cutoffReached}}" class="timing-hint">已到自动结束时间，时长不再增长；可点击圆盘结束并同步。</view>
        <view wx:elif="{{canContinue}}" class="timing-hint">已停止，原计时已保留。点击圆盘继续，停止期间不计时。{{courseEnded ? '课程已结束，也可直接结束计时并复盘。' : '下课后停止计时才会打开复盘。'}}</view>
        <view wx:elif="{{courseEnded && phase !== 'finished' && record}}" class="timing-hint">课内时长已停止累计，{{graceRemaining}} 后自动结束；也可现在点击停止。</view>
        <view wx:elif="{{courseEarly && phase !== 'finished'}}" class="timing-hint">准备中：课前准备单独记录，有效时长从上课时间起累计。</view>
        <view wx:elif="{{record && (record.finish_reason === 'timeout' || record.finish_reason === 'repair')}}" class="timing-hint">已按下课后 10 分钟的截止时间自动结束，点击圆盘填写复盘。</view>
      </view>
    </block>

    <view class="tp-footer-art" aria-hidden="true">
      <view class="tp-purple-paper"></view>
      <view class="tp-footer-curve"></view>
      <view class="tp-sprig">
        <view class="tp-sprig-stem"></view>
        <view class="tp-leaf tp-leaf--left"></view>
        <view class="tp-leaf tp-leaf--right"></view>
      </view>
      <view class="tp-footer-spark"></view>
    </view>
  </view>
</view>
<class-tab-bar selected="{{2}}" bind:select="switchClassTab"/>
<view wx:if="{{reviewOpen}}" class="review-modal-mask">
  <view class="review-modal-backdrop" catchtouchmove="stopReviewTouch"></view>
  <view class="review-modal" role="dialog" aria-label="本次课后复盘">
    <image class="review-modal-nessie" src="/assets/review/nessie.png" mode="aspectFit" aria-hidden="true"/>
    <view class="review-modal-underlay" aria-hidden="true"></view>
    <review-panel id="timer-review" class="review-modal-panel" session-id="{{reviewSessionId}}" visible="{{reviewVisible}}" bind:close="closeReview"/>
  </view>
</view>
