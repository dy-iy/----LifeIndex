<page-meta page-style="{{chartInspecting && chartTouching ? 'overflow: hidden;' : ''}}"/>
<view class="ip-page">
  <!-- 装饰放在内容后方，数值和图表保留干净的阅读区域。 -->
  <view class="ip-corner" aria-hidden="true"></view>
  <view class="ip-gold-spark" aria-hidden="true"></view>

  <view class="ip-content">
    <market-quote
      title="上课指数"
      value-text="{{header.price}}"
      change-points-text="{{header.points}}"
      change-percent-text="{{header.percent}}"
      direction="{{header.direction === 'rise' ? 'up' : header.direction === 'fall' ? 'down' : 'flat'}}"
      updated-at="{{header.stamp || (loggedIn ? '读取个人指数' : '登录后查看自己的指数')}}"
      status-text="{{header.state}}"
      stats="{{header.stats}}"
      refreshing="{{loading}}"
      refresh-disabled="{{!loggedIn || chartLoading || chartTouching}}"
      bind:refresh="reload"
    >
      <view wx:if="{{chartLoading}}" class="market-loading">读取图表中…</view>
      <view wx:if="{{!loggedIn}}" class="market-alert"><text>你的上课记录会形成独立的个人指数。</text><button class="market-action" bindtap="goLogin">前往登录</button></view>
    </market-quote>

    <view class="ip-chart-section">
      <market-chart-panel
        period="{{periods[tab]}}"
        can-zoom-out="{{!chart.empty && (tab === 0 ? intradayWindowMinutes < 240 : candleStep > 16)}}"
        can-zoom-in="{{!chart.empty && (tab === 0 ? intradayWindowMinutes > 15 : candleStep < 52)}}"
        busy="{{loading || chartLoading || chartTouching}}"
        hint="{{chartInspecting ? '拖动查看 · 松手 2 秒恢复' : tab === 0 ? '横滑时间轴 · 点击或长按读数' : '长按查看 · 横滑历史'}}"
        detail-text="{{tab !== 0 ? chart.candleCount + ' 根' : intradayWindowMinutes < 60 ? intradayWindowMinutes + ' 分钟' : intradayWindowMinutes / 60 + ' 小时'}}"
        period-note="{{tab === 0 ? '' : tab === 1 ? '自然日 · 含周末' : tab === 2 ? '周一开周' : '自然月'}}"
        bind:periodchange="changeTab"
        bind:zoom="changeChartZoom"
      >
        <view class="ip-chart-host">
          <view class="chart">
            <view class="chart-stage">
            <scroll-view scroll-x="{{!chartInspecting}}" scroll-left="{{chartScrollLeft}}" bindscroll="scrollChart" class="chart-scroll" enhanced show-scrollbar="{{false}}">
              <view class="chart-plot" style="width: {{chart.width}}rpx;" bindtouchstart="startChartTouch" bindtouchmove="moveChartTouch" bindtouchend="endChartTouch" bindtouchcancel="endChartTouch" bindlongpress="inspectChart" bindtap="tapChart">
                <view wx:for="{{chart.ticks}}" wx:key="slot" class="plot-grid" style="top: {{item.y}}rpx;"></view>
                <image wx:if="{{chart.lineImage}}" src="{{chart.lineImage}}" class="intraday-line" style="width: {{chart.width}}rpx;" mode="scaleToFill"/>
                <view wx:for="{{chart.markers}}" wx:key="id" class="plot-point-hit" style="left: {{item.x - 22}}rpx; top: {{item.y - 22}}rpx;"><view class="plot-point"></view></view>
                <view class="chart-time-axis" bindtouchstart="startChartAxisTouch" catchtap="tapChartAxis" catchlongpress="tapChartAxis">
                  <text wx:for="{{chart.renderLabels}}" wx:key="id" class="plot-label" style="left: {{item.x - 40}}rpx;">{{item.label}}</text>
                </view>
                <view wx:for="{{chart.renderCandles}}" wx:key="id" class="candle-hit {{selectedCandleId === item.id ? 'candle-selected' : ''}}" style="left: {{item.x - item.step / 2}}rpx; width: {{item.step}}rpx; color: {{item.color}};" role="button" aria-label="{{item.date}} 开{{item.open}} 高{{item.high}} 低{{item.low}} 收{{item.close}} {{item.ongoing ? '进行中' : ''}}"><view class="candle-wick" style="left: {{item.step / 2 - 1}}rpx; top: {{item.top}}rpx; height: {{item.wick}}rpx;"></view><view class="candle-body {{item.direction}}" style="left: {{(item.step - item.bodyWidth) / 2}}rpx; width: {{item.bodyWidth}}rpx; top: {{item.bodyTop}}rpx; height: {{item.bodyHeight}}rpx;"></view></view>
                <block wx:if="{{crosshair}}"><view class="plot-crosshair-v" style="left: {{crosshair.x}}rpx;"></view><view class="plot-crosshair-h" style="left: {{crosshair.lineLeft}}rpx; width: {{crosshair.lineWidth}}rpx; top: {{crosshair.y}}rpx;"></view><view wx:if="{{tab === 0}}" class="crosshair-dot" style="left: {{crosshair.x - 6}}rpx; top: {{crosshair.y - 6}}rpx;"></view><text class="crosshair-date" style="left: {{crosshair.labelLeft}}rpx; width: {{crosshair.labelWidth}}rpx;">{{crosshair.label}}</text></block>
              </view>
            </scroll-view>
            <view class="chart-axis"><text wx:for="{{chart.ticks}}" wx:key="slot" class="chart-axis-label {{item.direction}}" style="top: {{item.y}}rpx;">{{item.label}}</text></view>
            <text wx:if="{{crosshair}}" class="crosshair-price" style="top: {{crosshair.y - 22}}rpx;">{{crosshair.price}}</text>
            <view wx:if="{{tab !== 0 && chart.candleCount > 0 && chart.candleCount <= 6 && !chartInspecting}}" class="chart-history-hint" style="left: {{chart.historyHintLeft}}rpx;"><text>历史积累中</text><text>已记录 {{chart.candleCount}} 个周期</text></view>
            </view>
            <view wx:if="{{chart.empty}}" class="chart-empty"><image src="{{art.emptyMarket}}" class="chart-empty-art"/><view class="empty-title">{{!loggedIn ? '登录后查看个人指数' : chartLoading ? '读取行情中' : chartError ? '行情暂未读取成功' : tab === 0 ? '当天暂无行情' : '暂无行情历史'}}</view><view class="chart-empty-note">{{!loggedIn ? '计时与记录会体现在自己的指数中' : chartError ? '请检查网络后重试' : quoteActivated ? '行情会随计时和记录持续变化' : '首次开启计时后，指数开始持续运行'}}</view></view>
          </view>
        </view>
      </market-chart-panel>
    </view>
    <view wx:if="{{chartError || error}}" class="market-alert" role="alert">
      <text>{{chartError || error}}</text>
      <button class="market-action" disabled="{{loading || chartLoading}}" bindtap="retryChart">重新读取行情</button>
    </view>
    <button wx:if="{{nextBefore}}" class="market-action market-history" loading="{{chartLoading}}" disabled="{{loading || chartLoading}}" bindtap="olderCandles">加载更早 K 线</button>

    <view class="ip-footer-art" aria-hidden="true">
      <view class="ip-footer-paper"></view>
      <view class="ip-footer-curve"></view>
      <view class="ip-footer-dot"></view>
      <view class="ip-sprig"></view>
    </view>
  </view>
</view>
<class-tab-bar selected="{{0}}" bind:select="switchClassTab"/>
