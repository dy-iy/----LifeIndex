page { background: #fbf7ee; color: #183844; }

.ip-page {
  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  overflow: hidden;
  padding: 28rpx 40rpx 136rpx;
  padding-bottom: calc(136rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(136rpx + env(safe-area-inset-bottom));
  color: #183844;
  background-color: #fbf7ee;
  background-image:
    radial-gradient(rgba(149, 119, 73, .055) .6px, transparent 1px),
    linear-gradient(125deg, rgba(255, 255, 255, .42), rgba(250, 239, 218, .12));
  background-size: 7rpx 7rpx, 100% 100%;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.ip-content { position: relative; z-index: 1; }
.ip-chart-section { margin-top: 21rpx; }

/* slot 内的节点属于页面，容器样式保留在页面 WXSS 中。 */
.ip-chart-host { box-sizing: border-box; width: 100%; height: 100%; min-width: 0; }

.market-loading { margin-top: 4rpx; color: #879087; font-size: 22rpx; line-height: 32rpx; }
.market-alert { margin: 20rpx 0; padding: 18rpx 22rpx; border: 1rpx solid #e9dfd2; border-radius: 10rpx; background: #fff9ee; color: #7e796e; font-size: 24rpx; line-height: 1.7; overflow-wrap: anywhere; }
.market-action { margin: 8rpx 0 0; padding: 14rpx; color: #668397; background: transparent; font-size: 25rpx; line-height: 1.5; border-radius: 8rpx; }
.market-action::after { border: 0; }
.market-action[disabled] { color: #a4ada5; background: transparent; }
.market-history { margin-top: 16rpx; }

/* The plot's rpx coordinates and SVG height come from services/class-index.js. */
.chart { position: relative; width: 100%; height: 462rpx; overflow: hidden; background: #fff; }
.chart-stage { position: relative; height: 462rpx; }
.chart-scroll { display: block; width: 100%; height: 462rpx; }
.chart-plot { position: relative; height: 462rpx; }
.plot-grid { position: absolute; left: 104rpx; right: 44rpx; height: 1rpx; border-top: 1rpx dashed #ecefee; }
.intraday-line { position: absolute; top: 0; left: 0; height: 390rpx; pointer-events: none; }
.plot-point-hit { position: absolute; z-index: 2; display: flex; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; pointer-events: none; }
.plot-point { width: 6rpx; height: 6rpx; border: 1rpx solid #888; border-radius: 50%; background: #888; }
.plot-label { position: absolute; top: 392rpx; width: 80rpx; color: #7d8884; font-size: 22rpx; line-height: 44rpx; text-align: center; white-space: nowrap; }
.chart-axis { position: absolute; z-index: 3; top: 0; left: 0; width: 104rpx; height: 390rpx; background: #fff; pointer-events: none; }
.chart-axis-label { position: absolute; left: 8rpx; color: #7d8884; font-size: 21rpx; line-height: 32rpx; font-variant-numeric: tabular-nums; transform: translateY(-50%); }
.chart-axis-label.rise { color: #e53935; }
.chart-axis-label.fall { color: #15945e; }
.candle-hit { position: absolute; top: 0; height: 390rpx; }
.candle-selected { background: rgba(57, 125, 167, .05); }
.candle-wick { position: absolute; width: 2rpx; background: currentColor; }
.candle-body { position: absolute; box-sizing: border-box; background: currentColor; }
.candle-body.rise { color: #e53935; border: 2rpx solid #e53935; background: #fff; }
.candle-body.fall { color: #15945e; }
.candle-body.flat { color: #737b80; }
.plot-crosshair-v { position: absolute; z-index: 4; top: 24rpx; height: 376rpx; border-left: 1rpx solid #8c9ca3; pointer-events: none; }
.plot-crosshair-h { position: absolute; z-index: 4; border-top: 1rpx solid #8c9ca3; pointer-events: none; }
.crosshair-price, .crosshair-date { position: absolute; z-index: 5; border-radius: 4rpx; background: #49758f; color: #fff; font-size: 22rpx; line-height: 44rpx; font-variant-numeric: tabular-nums; text-align: center; pointer-events: none; }
.crosshair-price { left: 2rpx; width: 102rpx; }
.crosshair-date { top: 392rpx; }
.crosshair-dot { position: absolute; z-index: 5; width: 12rpx; height: 12rpx; border: 2rpx solid #fff; border-radius: 50%; background: #49758f; pointer-events: none; }
.chart-history-hint { position: absolute; top: 156rpx; right: 24rpx; color: #a4afa8; font-size: 24rpx; line-height: 1.8; text-align: center; pointer-events: none; }
.chart-history-hint > text { display: block; }
.chart-history-hint > text:last-child { color: #b2bbb6; font-size: 22rpx; }
.chart-empty { position: absolute; top: 55rpx; right: 24rpx; left: 24rpx; text-align: center; pointer-events: none; }
.chart-empty-art { width: 220rpx; height: 170rpx; }
.chart-empty .empty-title { margin-top: 3rpx; color: #52665f; font-size: 29rpx; }
.chart-empty-note { margin-top: 14rpx; color: #879087; font-size: 22rpx; line-height: 1.6; }

