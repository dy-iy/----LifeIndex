<page-meta page-style="{{agentOpen || selectedLesson || editor === 'semester' || editor === 'structured' ? 'overflow: hidden;' : ''}}"/>
<view class="page class-page timetable-page timetable-surface {{semester ? 'has-semester' : ''}}">
  <view class="title-row"><view class="page-title">课表</view><image class="title-art" src="{{art.schedule}}" mode="aspectFit"/></view>
  <view wx:if="{{!semester}}" class="prototype-note"><view class="prototype-dot"></view><text>课表保存至个人账户，计时页将自动识别当前课程。</text></view>
  <view wx:if="{{!loggedIn}}" class="empty-card"><view class="empty-title">让每一周有迹可循</view><view class="empty-copy">微信登录后，设置学期并保存自己的课程。</view><button size="mini" class="primary-button" bindtap="goLogin">去「我的」登录</button></view>
  <block wx:else>
    <view wx:if="{{message}}" class="saved-message">{{message}}</view>
    <view wx:if="{{error}}" class="error-panel"><view class="error">{{error}}</view><button size="mini" class="text-button" disabled="{{loading || saving}}" bindtap="reload">重新加载课表</button></view>
    <view wx:if="{{loading}}" class="loading-copy">正在读取学期…</view>
    <view wx:if="{{semester}}" class="semester-head">
      <picker class="{{(loading || saving) ? 'picker-disabled' : ''}}" range="{{semesters}}" range-key="name" value="{{semesterIndex}}" disabled="{{loading || saving}}" bindchange="selectSemester"><view class="picker-trigger semester-picker"><text class="picker-value">{{semester.name}}</text><view class="picker-chevron" aria-hidden="true"></view></view></picker>
      <view class="semester-actions"><text class="section-link" data-edit="{{true}}" bindtap="openSemester">设置</text><text class="section-link" bindtap="openSemester">＋ 新学期</text></view>
      <view class="small muted semester-meta">学期 {{semester.number}} · 共 {{semester.total_weeks}} 周</view>
    </view>
    <view wx:elif="{{!loading && !error}}" class="empty-card"><view class="empty-title">先设置你的学期</view><view class="empty-copy">填写学期名称和日期后，即可导入课表、设置作息和编辑课程。</view><button class="primary-button" bindtap="openSemester">＋ 设置学期</button></view>

    <view wx:if="{{editor === 'lesson'}}" class="course-editor">
      <view class="row-between"><text class="section-title">调整这一次课程</text><text class="section-link" bindtap="closeEditor">收起</text></view>
        <view class="lesson-heading">{{lessonForm.name}}</view><view class="small muted">只调整这一次课程，其他日期不变。</view>
        <text class="field-label">课程状态</text><picker class="{{(saving) ? 'picker-disabled' : ''}}" range="{{statuses}}" value="{{lessonForm.statusIndex}}" data-field="statusIndex" bindchange="inputField" disabled="{{saving}}"><view class="picker-trigger date-picker"><text class="picker-value">{{statuses[lessonForm.statusIndex]}}</text><view class="picker-chevron" aria-hidden="true"></view></view></picker><view class="small muted form-help">请假或停课后，可重新选择「正常上课」恢复。</view>
        <text class="field-label">上课日期</text><picker class="{{(saving) ? 'picker-disabled' : ''}}" mode="date" value="{{lessonForm.date}}" start="{{semester.start_date}}" end="{{semester.end_date}}" data-field="date" bindchange="inputField" disabled="{{saving}}"><view class="picker-trigger date-picker"><text class="picker-value">{{lessonForm.date}}</text><view class="picker-chevron" aria-hidden="true"></view></view></picker>
        <text class="field-label">上课时间</text><view class="time-fields"><picker class="{{(saving) ? 'picker-disabled' : ''}}" mode="time" value="{{lessonForm.start_time}}" data-field="start_time" bindchange="inputField" disabled="{{saving}}"><view class="picker-trigger time-picker"><text class="picker-value">{{lessonForm.start_time}}</text><view class="picker-chevron" aria-hidden="true"></view></view></picker><text class="muted">—</text><picker class="{{(saving) ? 'picker-disabled' : ''}}" mode="time" value="{{lessonForm.end_time}}" data-field="end_time" bindchange="inputField" disabled="{{saving}}"><view class="picker-trigger time-picker"><text class="picker-value">{{lessonForm.end_time}}</text><view class="picker-chevron" aria-hidden="true"></view></view></picker></view>
        <text class="field-label">备注 <text class="muted">可选</text></text><input class="field-input" value="{{lessonForm.note}}" data-field="note" bindinput="inputField" maxlength="500" placeholder="例如：调至实验室上课" disabled="{{saving}}"/>
      <view wx:if="{{formError}}" class="error">{{formError}}</view><button size="mini" wx:if="{{conflict}}" class="text-button" bindtap="rebaseVersion" disabled="{{saving}}">读取最新版本，保留输入</button>
      <button size="mini" class="primary-button editor-button" loading="{{saving}}" disabled="{{saving}}" bindtap="saveLesson">{{saving ? '正在保存…' : '保存本次调整'}}</button>
      <view class="rule-note">保存失败会保留输入。切换账户将清除本机草稿。</view>
    </view>

    <block wx:if="{{semester}}">
      <view class="section-head schedule-heading"><view><text class="eyebrow">WEEKLY PLANNER</text><text class="section-title">把一周安排好</text></view><view class="view-switch"><text class="{{viewMode === 'week' ? 'active' : ''}}" data-mode="week" bindtap="changeView">周课表</text><text class="{{viewMode === 'day' ? 'active' : ''}}" data-mode="day" bindtap="changeView">日程</text></view></view>
      <view class="planner-toolbar"><view class="week-navigation"><button size="mini" class="week-arrow" disabled="{{loading || saving || !canPreviousWeek}}" data-step="-1" bindtap="shiftWeek" aria-label="上一周">‹</button><picker class="{{(loading || saving) ? 'picker-disabled' : ''}}" range="{{weekOptions}}" range-key="label" value="{{weekIndex}}" disabled="{{loading || saving}}" bindchange="selectWeek"><view class="picker-trigger week-picker"><text class="picker-value">第 {{weekNumber || 1}} 周</text><view class="picker-chevron" aria-hidden="true"></view></view></picker><button size="mini" class="week-arrow" disabled="{{loading || saving || !canNextWeek}}" data-step="1" bindtap="shiftWeek" aria-label="下一周">›</button></view><button size="mini" class="today-button" disabled="{{loading || saving}}" bindtap="currentWeek">回到本周</button></view>
      <view wx:if="{{lessonsLoading}}" class="loading-copy">正在读取本周课次…</view>
      <view wx:if="{{lessonsError}}" class="error-panel"><view class="error">{{lessonsError}}</view><button size="mini" class="text-button" disabled="{{loading || lessonsLoading || saving}}" bindtap="retryLessons">重新读取课次</button></view>
      <view wx:if="{{coursesLoading}}" class="loading-copy">正在读取课程安排…</view>
      <view wx:if="{{coursesError}}" class="error-panel"><view class="error">{{coursesError}}</view><button size="mini" class="text-button" disabled="{{loading || coursesLoading || saving}}" bindtap="retryCourses">重新读取课程安排</button></view>
      <view class="week-caption"><text>{{grid.weekStart}} — {{grid.weekEnd}}</text><text>{{loading || lessonsLoading ? '读取中…' : lessonsError ? '课次读取失败' : '本周 ' + grid.scheduledCount + ' 次课'}}</text></view>
      <week-timetable wx:if="{{viewMode === 'week' && grid}}" grid="{{grid}}" disabled="{{loading || lessonsLoading || saving}}" show-empty="{{!loading && !error && !lessonsLoading && !lessonsError}}" bind:selectlesson="inspectLesson"/>
      <block wx:if="{{viewMode === 'day'}}">
      <picker class="{{(loading || saving) ? 'picker-disabled' : ''}}" mode="date" value="{{selectedDate}}" start="{{semester.start_date}}" end="{{semester.end_date}}" disabled="{{loading || saving}}" bindchange="changeDate"><view class="picker-trigger day-date-picker"><text class="picker-value">{{selectedDate}}</text><text class="picker-detail">选择日期</text><view class="picker-chevron" aria-hidden="true"></view></view></picker>
      <view class="week-strip"><view wx:for="{{weekDays}}" wx:key="date" class="week-day {{selectedDate === item.date ? 'selected' : ''}} {{item.disabled ? 'outside-term' : ''}}" data-date="{{item.date}}" data-disabled="{{item.disabled}}" bindtap="chooseDay" role="button" aria-label="{{item.date}} 周{{item.label}}"><text class="week-prefix">周{{item.label}}</text><text class="week-name">{{item.number}}</text><view class="week-dot {{item.hasCourse ? 'has-course' : ''}}"></view></view></view>
      <view wx:if="{{!loading && !error && !lessonsLoading && !lessonsError && !visibleLessons.length}}" class="schedule-empty"><text class="empty-number serif">— : —</text><view class="empty-title">{{viewMode === 'week' ? '本周暂无课程' : '当天暂无课程'}}</view><view class="empty-copy">留一点空白，也可以安排新的课程。</view></view>
      <view wx:for="{{visibleLessons}}" wx:key="id" class="course-ticket {{item.status !== 'scheduled' ? 'inactive-ticket' : ''}}"><view class="ticket-top"><text class="eyebrow">{{item.local_date}} · 第 {{item.actualWeek}} 周</text><text class="pill">{{item.statusLabel}}{{item.hasOverlap ? ' · 重叠' : ''}}</text></view><view class="course-name">{{item.name}}</view><view class="course-time serif">{{item.start_time}}<text> — </text>{{item.end_time}}</view><view wx:if="{{item.location}}" class="small muted form-help">{{item.location}}</view><view wx:if="{{item.note}}" class="small muted">{{item.note}}</view><view class="ticket-divider"></view><view class="row-between"><text class="small muted">{{item.duration_minutes}} 分钟{{item.is_override ? ' · 已单独调整' : ''}}</text><text wx:if="{{item.canAdjust}}" class="ticket-edit" data-id="{{item.id}}" bindtap="openLesson">调课 / 请假 / 停课 ↗</text></view></view>
      </block>
      <view class="agent-import-action"><button class="primary-button agent-import-button" disabled="{{loading || saving}}" bindtap="openAgent">Agent自动导入</button></view>
    </block>
    <block wx:if="{{semester}}">
    <view class="section-head" bindtap="toggleCourses"><text class="section-title">课程信息 · {{structuredCourses.length}} 门</text><view class="course-list-toggle"><text>{{courseListOpen ? '收起' : '管理'}}</text><view class="picker-chevron {{courseListOpen ? 'picker-chevron--up' : ''}}" aria-hidden="true"></view></view></view>
    <block wx:if="{{courseListOpen}}">
      <view wx:if="{{structuredLoading}}" class="loading-copy">正在读取课程信息…</view>
      <view wx:if="{{structuredError}}" class="error-panel"><view class="error">{{structuredError}}</view><button size="mini" class="text-button" disabled="{{loading || structuredLoading || saving}}" bindtap="retryStructured">重新读取课程信息</button></view>
      <view wx:if="{{!structuredCourses.length && !loading && !error && !structuredLoading && !structuredError}}" class="small muted">本学期尚无课程信息。上传截图或直接描述课程即可保存。</view>
      <view wx:for="{{structuredCourses}}" wx:for-item="course" wx:key="id" class="structured-course">
        <view class="row-between"><text class="template-name">{{course.nameLabel}}</text><text class="section-link" data-id="{{course.id}}" bindtap="openStructuredCourse">编辑</text></view>
        <view wx:if="{{course.noSchedules}}" class="small muted">安排未知 · 可以随时补充</view>
        <view wx:for="{{course.schedules}}" wx:for-item="schedule" wx:key="id" class="structured-schedule">
          <view>{{schedule.weekdayLabel}} · {{schedule.timeLabel}}</view><view>{{schedule.weeksLabel}} · {{schedule.periodsLabel}}</view><view>教师：{{schedule.teacherLabel}} · 地点：{{schedule.locationLabel}}</view>
          <text wx:if="{{schedule.missingLabel}}" class="missing-information">{{schedule.missingLabel}} · 先保存在课程列表</text>
        </view>
      </view>
      <button wx:if="{{structuredDocument}}" size="mini" class="text-button structured-add" disabled="{{saving || loading || structuredLoading}}" bindtap="openStructuredCourse">＋ 添加课程信息</button>
    </block>
    </block>
  </block>
</view>
<class-tab-bar selected="{{1}}" bind:select="switchClassTab"/>
<view wx:if="{{loggedIn && editor === 'semester'}}" class="course-editor-overlay timetable-surface {{courseKeyboardHeight ? 'keyboard-open' : ''}}" style="bottom: {{courseKeyboardHeight}}px;">
  <view class="course-editor-backdrop" catchtap="closeEditor" catchtouchmove="noop"></view>
  <view class="course-dialog semester-dialog" role="dialog" aria-modal="true" aria-label="{{semesterForm.id ? '学期设置' : '新建学期'}}" catchtap="noop">
    <view class="course-dialog-header row-between" catchtouchmove="noop">
      <view><text class="eyebrow">安排新学期的节奏</text><text class="course-dialog-title">{{semesterForm.id ? '学期设置' : '新建学期'}}</text></view>
      <button size="mini" class="detail-close" bindtap="closeEditor" disabled="{{saving}}" aria-label="关闭学期设置">×</button>
    </view>
    <view class="course-dialog-body">
      <scroll-view class="course-dialog-scroll" scroll-y="{{true}}" scroll-top="{{courseScrollTop}}" scroll-with-animation="{{false}}" bindscroll="onCourseDialogScroll" bindtouchstart="onCourseDialogTouchStart" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="course-dialog-content">
        <text class="field-label">学期名称</text><input always-embed="{{true}}" id="course-field-semester-name" cursor="{{courseInputCursors['course-field-semester-name']}}" adjust-position="{{false}}" bindfocus="onCourseFieldFocus" bindblur="onCourseFieldBlur" bindkeyboardheightchange="onCourseKeyboardHeightChange" class="field-input" value="{{semesterForm.name}}" data-field="name" bindinput="inputField" maxlength="80" placeholder="例如：2026 秋季学期" disabled="{{saving}}"/>
        <text class="field-label">学期起止日期</text><view class="time-fields">
          <picker class="{{(saving || (semesterForm.id && (semesterForm.has_courses || courses.length))) ? 'picker-disabled' : ''}}" mode="date" value="{{semesterForm.start_date}}" data-field="start_date" disabled="{{saving || (semesterForm.id && (semesterForm.has_courses || courses.length))}}" bindchange="inputField"><view class="picker-trigger date-picker"><text class="picker-value">{{semesterForm.start_date || '选择开始日期'}}</text><view class="picker-chevron" aria-hidden="true"></view></view></picker>
          <text class="muted">至</text><picker class="{{(saving || (semesterForm.id && (semesterForm.has_courses || courses.length))) ? 'picker-disabled' : ''}}" mode="date" value="{{semesterForm.end_date}}" data-field="end_date" disabled="{{saving || (semesterForm.id && (semesterForm.has_courses || courses.length))}}" bindchange="inputField"><view class="picker-trigger date-picker"><text class="picker-value">{{semesterForm.end_date || '选择结束日期'}}</text><view class="picker-chevron" aria-hidden="true"></view></view></picker>
        </view>
        <view class="small muted form-help">第 1 周从 {{semesterForm.first_week_monday || '开始日期所在周一'}} 起算，周一至周日为一周。</view>
        <view wx:if="{{semesterForm.id && (semesterForm.has_courses || courses.length)}}" class="rule-note">已有课程后，学期日期不可更改。修改作息时间后，已有节次的课程会同步更新时间。</view>
        <view class="section-head compact"><text class="section-title">作息时间 <text class="small muted">可选</text></text><text class="section-link" bindtap="addPeriod">＋ 添加节次</text></view>
        <view class="small muted">设置各节起止时间，课程会按所选节次自动生成包含课间的时间范围。</view>
        <view wx:for="{{semesterForm.periods}}" wx:key="_formKey" class="period-row">
          <input always-embed="{{true}}" id="course-field-period-{{index}}-number" cursor="{{courseInputCursors['course-field-period-' + index + '-number']}}" adjust-position="{{false}}" bindfocus="onCourseFieldFocus" bindblur="onCourseFieldBlur" bindkeyboardheightchange="onCourseKeyboardHeightChange" class="field-input period-number" type="number" value="{{item.number}}" data-index="{{index}}" data-field="number" bindinput="inputPeriod" disabled="{{saving}}"/>
          <picker class="{{(saving) ? 'picker-disabled' : ''}}" mode="time" value="{{item.start_time}}" data-index="{{index}}" data-field="start_time" bindchange="inputPeriod" disabled="{{saving}}"><view class="picker-trigger date-picker"><text class="picker-value">{{item.start_time || '开始时间'}}</text><view class="picker-chevron" aria-hidden="true"></view></view></picker><text>—</text>
          <picker class="{{(saving) ? 'picker-disabled' : ''}}" mode="time" value="{{item.end_time}}" data-index="{{index}}" data-field="end_time" bindchange="inputPeriod" disabled="{{saving}}"><view class="picker-trigger date-picker"><text class="picker-value">{{item.end_time || '结束时间'}}</text><view class="picker-chevron" aria-hidden="true"></view></view></picker>
          <view class="period-actions"><text class="remove-period" data-index="{{index}}" bindtap="removePeriod">移除</text><text wx:if="{{item.start_time || item.end_time}}" class="remove-period" data-index="{{index}}" bindtap="clearPeriodTime">清空时间</text></view>
        </view>
        <view class="rule-note">保存失败会保留输入。切换账户将清除本机草稿。</view>
        </view>
      </scroll-view>
    </view>
    <view class="course-dialog-footer" catchtouchmove="noop">
      <view wx:if="{{formError}}" class="error">{{formError}}</view>
      <button size="mini" wx:if="{{conflict}}" class="text-button" bindtap="rebaseVersion" disabled="{{saving}}">读取最新版本，保留输入</button>
      <view class="course-dialog-actions">
        <button size="mini" class="secondary-button" bindtap="closeEditor" disabled="{{saving}}">取消</button>
        <button size="mini" class="primary-button" loading="{{saving}}" disabled="{{saving}}" bindtap="saveSemester">{{saving ? '正在保存…' : '保存学期'}}</button>
      </view>
    </view>
  </view>
</view>
<view wx:if="{{loggedIn && editor === 'structured'}}" class="course-editor-overlay timetable-surface {{courseKeyboardHeight ? 'keyboard-open' : ''}}" style="bottom: {{courseKeyboardHeight}}px;">
  <view class="course-editor-backdrop" catchtap="closeEditor" catchtouchmove="noop"></view>
  <view class="course-dialog" role="dialog" aria-modal="true" aria-label="{{structuredForm.id ? '编辑课程信息' : '添加课程信息'}}" catchtap="noop">
    <view class="course-dialog-header row-between" catchtouchmove="noop"><view><text class="eyebrow">随时补充与修改</text><text class="course-dialog-title">{{structuredForm.id ? '编辑课程信息' : '添加课程信息'}}</text></view><button size="mini" class="detail-close" bindtap="closeEditor" disabled="{{saving}}" aria-label="关闭编辑">×</button></view>
    <view class="course-dialog-body"><scroll-view class="course-dialog-scroll" scroll-y="{{true}}" scroll-top="{{courseScrollTop}}" scroll-with-animation="{{false}}" bindscroll="onCourseDialogScroll" bindtouchstart="onCourseDialogTouchStart" enhanced="{{true}}" show-scrollbar="{{false}}"><view class="course-dialog-content">
      <view class="rule-note">所有信息均可留空。清空已有字段会保存为未知；完整的安排会自动进入周课表。</view>
      <text class="field-label">课程名称</text><input always-embed="{{true}}" id="course-field-name" cursor="{{courseInputCursors['course-field-name']}}" class="field-input" value="{{structuredForm.name}}" data-field="name" bindinput="inputField" bindfocus="onCourseFieldFocus" bindblur="onCourseFieldBlur" bindkeyboardheightchange="onCourseKeyboardHeightChange" adjust-position="{{false}}" maxlength="100" placeholder="未知，可留空" disabled="{{saving}}"/>
      <view wx:for="{{structuredForm.schedules}}" wx:for-item="schedule" wx:for-index="scheduleIndex" wx:key="_formKey" class="structured-schedule-editor" id="course-field-schedule-{{scheduleIndex}}">
        <view class="row-between"><text class="section-title">安排 {{scheduleIndex + 1}}</text><text class="section-link danger" data-index="{{scheduleIndex}}" bindtap="removeStructuredSchedule">移除安排</text></view>
        <text class="field-label">星期</text><picker range="{{structuredDays}}" value="{{schedule.weekdayIndex}}" data-index="{{scheduleIndex}}" data-field="weekdayIndex" bindchange="inputStructuredSchedule" disabled="{{saving}}"><view class="picker-trigger date-picker"><text class="picker-value">{{structuredDays[schedule.weekdayIndex]}}</text><view class="picker-chevron" aria-hidden="true"></view></view></picker>
        <text class="field-label">周次</text><input always-embed="{{true}}" id="course-field-schedule-{{scheduleIndex}}-weeks" cursor="{{courseInputCursors['course-field-schedule-' + scheduleIndex + '-weeks']}}" class="field-input" value="{{schedule.weeks}}" data-index="{{scheduleIndex}}" data-field="weeks" bindinput="inputStructuredSchedule" bindfocus="onCourseFieldFocus" bindblur="onCourseFieldBlur" bindkeyboardheightchange="onCourseKeyboardHeightChange" adjust-position="{{false}}" placeholder="例如 1,3,5 或 9-16；未知留空" disabled="{{saving}}"/>
        <text class="field-label">节次</text><input always-embed="{{true}}" id="course-field-schedule-{{scheduleIndex}}-period_numbers" cursor="{{courseInputCursors['course-field-schedule-' + scheduleIndex + '-period_numbers']}}" class="field-input" value="{{schedule.period_numbers}}" data-index="{{scheduleIndex}}" data-field="period_numbers" bindinput="inputStructuredSchedule" bindfocus="onCourseFieldFocus" bindblur="onCourseFieldBlur" bindkeyboardheightchange="onCourseKeyboardHeightChange" adjust-position="{{false}}" placeholder="例如 1,2；未知留空" disabled="{{saving}}"/>
        <text class="field-label">上课时间</text>
        <view class="time-fields"><input always-embed="{{true}}" id="course-field-schedule-{{scheduleIndex}}-start_time" cursor="{{courseInputCursors['course-field-schedule-' + scheduleIndex + '-start_time']}}" class="field-input" value="{{schedule.start_time}}" data-index="{{scheduleIndex}}" data-field="start_time" bindinput="inputStructuredSchedule" bindfocus="onCourseFieldFocus" bindblur="onCourseFieldBlur" bindkeyboardheightchange="onCourseKeyboardHeightChange" adjust-position="{{false}}" placeholder="开始时间未知" maxlength="5" disabled="{{true}}"/><text class="muted">—</text><input always-embed="{{true}}" id="course-field-schedule-{{scheduleIndex}}-end_time" cursor="{{courseInputCursors['course-field-schedule-' + scheduleIndex + '-end_time']}}" class="field-input" value="{{schedule.end_time}}" data-index="{{scheduleIndex}}" data-field="end_time" bindinput="inputStructuredSchedule" bindfocus="onCourseFieldFocus" bindblur="onCourseFieldBlur" bindkeyboardheightchange="onCourseKeyboardHeightChange" adjust-position="{{false}}" placeholder="结束时间未知" maxlength="5" disabled="{{true}}"/></view>
        <view class="small muted form-help">按学期作息自动生成，包含课间；修改节次即可调整时间。</view>
        <text class="field-label">教师</text><input always-embed="{{true}}" id="course-field-schedule-{{scheduleIndex}}-teacher" cursor="{{courseInputCursors['course-field-schedule-' + scheduleIndex + '-teacher']}}" class="field-input" value="{{schedule.teacher}}" data-index="{{scheduleIndex}}" data-field="teacher" bindinput="inputStructuredSchedule" bindfocus="onCourseFieldFocus" bindblur="onCourseFieldBlur" bindkeyboardheightchange="onCourseKeyboardHeightChange" adjust-position="{{false}}" maxlength="100" placeholder="未知，可留空" disabled="{{saving}}"/>
        <text class="field-label">地点</text><input always-embed="{{true}}" id="course-field-schedule-{{scheduleIndex}}-location" cursor="{{courseInputCursors['course-field-schedule-' + scheduleIndex + '-location']}}" class="field-input" value="{{schedule.location}}" data-index="{{scheduleIndex}}" data-field="location" bindinput="inputStructuredSchedule" bindfocus="onCourseFieldFocus" bindblur="onCourseFieldBlur" bindkeyboardheightchange="onCourseKeyboardHeightChange" adjust-position="{{false}}" maxlength="200" placeholder="未知，可留空" disabled="{{saving}}"/>
      </view>
      <button size="mini" class="text-button structured-add" disabled="{{saving}}" bindtap="addStructuredSchedule">＋ 添加上课安排</button>
      <view wx:if="{{structuredForm.id}}" class="rule-note">修改或移除安排会同步到课表；已有计时和记录历史独立保存。正在计时或暂停的课次需先结束计时。</view>
    </view></scroll-view></view>
    <view class="course-dialog-footer" catchtouchmove="noop"><view wx:if="{{formError}}" class="error">{{formError}}</view><button wx:if="{{conflict}}" size="mini" class="text-button" disabled="{{saving}}" bindtap="rebaseStructuredVersion">读取最新版本，保留修改</button><view class="course-dialog-actions"><button wx:if="{{structuredForm.id}}" size="mini" class="course-delete-button" loading="{{structuredDeleting}}" disabled="{{saving}}" bindtap="deleteStructuredCourse">{{structuredDeleting ? '正在删除…' : '删除'}}</button><button size="mini" class="primary-button" loading="{{saving && !structuredDeleting}}" disabled="{{saving}}" bindtap="saveStructuredCourse">{{saving && !structuredDeleting ? '正在保存…' : '保存课程信息'}}</button></view></view>
  </view>
</view>
<view wx:if="{{selectedLesson}}" class="lesson-overlay timetable-surface" catchtouchmove="noop">
  <view class="lesson-backdrop" bindtap="closeLessonDetails"></view>
  <view class="lesson-dialog" role="dialog" aria-label="课程详情">
    <view class="row-between"><text class="eyebrow">COURSE DETAILS</text><button size="mini" class="detail-close" bindtap="closeLessonDetails" aria-label="关闭课程详情">×</button></view>
    <scroll-view scroll-y class="lesson-detail-body"><view class="detail-name">{{selectedLesson.name}}</view>
      <view class="detail-time serif">{{selectedLesson.start_time}} — {{selectedLesson.end_time}}</view>
      <view class="detail-date">{{selectedLesson.local_date}} · 第 {{selectedLesson.actualWeek}} 周</view>
      <view class="detail-meta"><text class="pill">{{selectedLesson.statusLabel}}</text><text wx:if="{{selectedLesson.hasOverlap}}" class="pill">时间重叠</text><text wx:if="{{selectedLesson.is_override}}" class="pill">已单独调整</text></view>
      <view class="detail-info"><text class="muted">地点</text><text>{{selectedLesson.location || '暂未填写'}}</text></view>
      <view class="detail-info"><text class="muted">课程安排</text><text>{{selectedLesson.repeatLabel}}</text></view>
      <view wx:if="{{selectedLesson.note}}" class="detail-info"><text class="muted">备注</text><text>{{selectedLesson.note}}</text></view>
      <view wx:if="{{error}}" class="error">{{error}}</view>
    </scroll-view>
    <button size="mini" wx:if="{{selectedLesson.canAdjust}}" class="primary-button" bindtap="editSelectedLesson">调整这一次 · 调课 / 请假 / 停课</button>
    <view class="detail-history">计时和记录历史独立保留；正在计时或暂停时需先结束计时，再修改或删除课次。</view>
    <button size="mini" wx:if="{{selectedLesson.canEditCourse}}" class="text-button" bindtap="editSelectedCourse">编辑这门课的安排 →</button>
    <view class="lesson-delete-actions">
      <button size="mini" wx:if="{{selectedLesson.canAdjust}}" class="text-button danger" disabled="{{saving}}" data-id="{{selectedLesson.id}}" bindtap="deleteLesson">删除这一次</button>
      <button size="mini" wx:if="{{selectedLesson.canEditCourse}}" class="text-button danger" disabled="{{saving}}" data-id="{{selectedLesson.course_id}}" bindtap="deleteCourse">删除这项每周安排</button>
    </view>
  </view>
</view>
<timetable-assistant wx:if="{{agentOpen && semester}}" id="timetable-assistant" semester-id="{{agentSemesterId}}" bind:close="closeAgent" bind:applied="onAgentApplied"/>
