@import "../../group-page-theme.wxss";

.chat-room { display: flex; flex-direction: column; height: 100vh; overflow: hidden; }
.room-navigation { flex-shrink: 0; }
.room-content { display: flex; flex: 1; flex-direction: column; min-height: 0; overflow: hidden; }
.room-chat-panel { flex: 1; min-height: 0; height: 100%; }
.room-panel-hidden { display: none; }
.room-index-scroll { flex: 1; min-height: 0; height: 100%; }
.room-index { padding: 24rpx 28rpx 40rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.room-checkin-panel { flex: 1; min-height: 0; height: 100%; }
.room-checkin-scroll { height: 100%; }
.room-checkin-content { padding: 22rpx 28rpx 40rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.room-status { padding: 52rpx 40rpx; color: #8a9187; font-size: 26rpx; line-height: 1.7; text-align: center; }
.room-error { color: #ad5948; }
.room-retry { display: inline-block; margin: 24rpx 0 0; padding: 12rpx 32rpx; border-radius: 12rpx; color: #496951; background: #eeeee7; font-size: 25rpx; line-height: 1.6; }
