.review-modal-mask { position: fixed; inset: 0; z-index: 300; display: flex; align-items: center; justify-content: center; padding: calc(24rpx + env(safe-area-inset-top)) 28rpx calc(24rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.review-modal-backdrop { position: absolute; inset: 0; background: rgba(30, 45, 39, .45); }
.review-modal { position: relative; width: 100%; max-width: 660rpx; height: 760rpx; max-height: 75vh; display: flex; flex-direction: column; overflow: visible; border-radius: 30rpx; background: #faf7f2; box-shadow: 0 20rpx 80rpx rgba(30, 45, 39, .2); }
.review-modal-header { display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; padding: 24rpx 28rpx; border-bottom: 1rpx solid #e4dfd5; }
.review-modal-title { font-family: "Songti SC", serif; font-size: 32rpx; color: #293f3b; }
.review-modal-header .review-modal-close { flex: 0 0 auto; width: auto; min-width: 0; margin: 0 0 0 auto; padding: 10rpx 0 10rpx 24rpx; background: transparent; color: #7a837f; font-size: 24rpx; line-height: 1.4; text-align: right; white-space: nowrap; }
.review-modal-panel { display: block; flex: 1; height: 0; min-height: 0; width: 100%; }
