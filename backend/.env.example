# Copy to .env manually; never commit real credentials.
DATABASE_URL=postgresql+psycopg://lifefund:REPLACE_ME@127.0.0.1:5432/lifefund
WECHAT_APP_ID=
WECHAT_APP_SECRET=
SESSION_TTL_SECONDS=2592000
# Enable group writes only after migration, backup and client verification.
GROUP_MANAGEMENT_ENABLED=false
# Fixed, persistent signing key; use at least 32 random bytes (for example 64 hex chars).
# Never replace this with a newly generated key at application startup.
GROUP_INVITE_KEY_ID=v1
GROUP_INVITE_SIGNING_KEY=
# Timetable assistant: doubao-seed-2-1-pro-260915 via Volcengine Ark.
ARK_API_KEY=
# Evaluation and legacy chat continue to use DeepSeek.
DEEPSEEK_API_KEY=
# Evaluation and legacy chat calls per user per UTC day; NOT a CNY budget.
# Timetable assistant has no request-count or daily cost cap.
AI_DAILY_REQUEST_LIMIT=20
# Timetable rates are for usage accounting only, not budget enforcement.
# doubao-seed-2.1-pro regular online inference CNY per million tokens, checked 2026-10-13.
# https://docs.volcengine.com/docs/ark/model-pricing?lang=zh
SCHEDULE_INPUT_CNY_PER_MILLION=6
SCHEDULE_OUTPUT_CNY_PER_MILLION=30

# Per-user daily evaluation budget, in micro CNY; rates are configurable estimates.
EVALUATION_DAILY_BUDGET_MICRO_CNY=1000000
EVALUATION_INPUT_CNY_PER_MILLION=2
EVALUATION_OUTPUT_CNY_PER_MILLION=8
