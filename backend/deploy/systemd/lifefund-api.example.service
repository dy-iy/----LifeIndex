# 使用前创建 lifefund 用户，并按自己的安装位置修改路径。
# API lifespan 同时启动后台任务线程；保持单实例，不使用 --workers 或 --reload。
# PM2 与 systemd 二选一，不另行启动独立 worker 服务。
[Unit]
Description=Lifefund API and background tasks
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=lifefund
Group=lifefund
WorkingDirectory=/opt/lifefund/backend
ExecStart=/opt/lifefund/backend/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8003 --proxy-headers --forwarded-allow-ips=127.0.0.1
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3
TimeoutStopSec=210
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
